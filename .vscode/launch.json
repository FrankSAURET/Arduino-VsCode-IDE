// A launch configuration that compiles the extension and then opens it inside a new window
// Pas de "runtimeExecutable" ici : il fait relancer VS Code comme un simple
// programme node, l'hote d'extensions demarre en pause ("STOPPED on first
// line for debugging") et se fait tuer (code 134) quand l'attachement tarde.
// VS Code sait deja quel executable lancer pour le type extensionHost.
{
    "version": "0.2.0",
    "configurations": [
        {
            // Configuration de diagnostic : l'hote demarre SANS debogueur attache.
            // Les hotes qui meurent en 134 le font a 1,20-1,25 s de leur
            // demarrage, avec une regularite de metronome, alors que les hotes
            // sains atteignent leur exthost.log a 1,80-1,93 s. Un delai fixe,
            // pas une pénurie de ressources : le suspect est l'attachement du
            // debogueur qui n'aboutit pas dans le temps imparti.
            // Si cette configuration ne plante jamais, la cause est confirmee.
            "name": "Launch Extension (sans debogueur)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "noDebug": true,
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            // Journal du debogueur, pour capturer l'echec d'attachement.
            "trace": true,
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Tests",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "${workspaceRoot}/test/resources/blink",
                "--extensionDevelopmentPath=${workspaceRoot}",
                "--extensionTestsPath=${workspaceRoot}/out/test"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/test/**/*.js"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Extension in Development",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            "preLaunchTask": "build_without_view"
        }
    ]
}
