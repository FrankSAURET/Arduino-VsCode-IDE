// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            // runtimeArgs, pas args : VS Code filtre "args" pour le type
            // extensionHost et jette --user-data-dir sans rien dire. La fenetre
            // repartait alors sur le profil principal, chargeait les ~40
            // extensions installees, et l'hote d'extensions tombait (code 134).
            "runtimeArgs": [
                // Profil isole, hors du depot pour survivre aux nettoyages
                "--user-data-dir=${env:LOCALAPPDATA}/Arduino-VsCode-IDE-debug-profile",
                // Aucune extension tierce : seule celle en cours de mise au point
                "--disable-extensions"
            ],
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "stopOnEntry": false,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Tests",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            // runtimeArgs, pas args : VS Code filtre "args" pour le type
            // extensionHost et jette --user-data-dir sans rien dire. La fenetre
            // repartait alors sur le profil principal, chargeait les ~40
            // extensions installees, et l'hote d'extensions tombait (code 134).
            "runtimeArgs": [
                // Profil isole, hors du depot pour survivre aux nettoyages
                "--user-data-dir=${env:LOCALAPPDATA}/Arduino-VsCode-IDE-debug-profile",
                // Aucune extension tierce : seule celle en cours de mise au point
                "--disable-extensions"
            ],
            "args": [
                "${workspaceRoot}/test/resources/blink",
                "--extensionDevelopmentPath=${workspaceRoot}",
                "--extensionTestsPath=${workspaceRoot}/out/test"
            ],
            "stopOnEntry": false,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/test/**/*.js"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Extension in Development",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            // runtimeArgs, pas args : VS Code filtre "args" pour le type
            // extensionHost et jette --user-data-dir sans rien dire. La fenetre
            // repartait alors sur le profil principal, chargeait les ~40
            // extensions installees, et l'hote d'extensions tombait (code 134).
            "runtimeArgs": [
                // Profil isole, hors du depot pour survivre aux nettoyages
                "--user-data-dir=${env:LOCALAPPDATA}/Arduino-VsCode-IDE-debug-profile",
                // Aucune extension tierce : seule celle en cours de mise au point
                "--disable-extensions"
            ],
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "stopOnEntry": false,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            "preLaunchTask": "build_without_view"
        }
    ]
}
