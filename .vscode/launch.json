// A launch configuration that compiles the extension and then opens it inside a new window
// Pas de "runtimeExecutable" ici : il fait relancer VS Code comme un simple
// programme node, l'hote d'extensions demarre en pause ("STOPPED on first
// line for debugging") et se fait tuer (code 134) quand l'attachement tarde.
// VS Code sait deja quel executable lancer pour le type extensionHost.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Tests",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "${workspaceRoot}/test/resources/blink",
                "--extensionDevelopmentPath=${workspaceRoot}",
                "--extensionTestsPath=${workspaceRoot}/out/test"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/test/**/*.js"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Launch Extension in Development",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/out/src/**/*.js"
            ],
            "preLaunchTask": "build_without_view"
        }
    ]
}
