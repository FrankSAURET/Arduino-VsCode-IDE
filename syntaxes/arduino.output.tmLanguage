<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>scopeName</key>
        <string>arduino.output</string>
        <key>name</key>
        <string>arduino-output</string>
        <key>patterns</key>
        <array>
            <!-- Les lignes emises par arduinoChannel portent un marqueur invisible
                 en fin de ligne : la categorie est reconnue quelle que soit la langue. -->
            <dict>
                <key>captures</key>
                <dict>
                    <key>1</key>
                    <dict>
                        <key>name</key>
                        <string>token.error-token</string>
                    </dict>
                </dict>
                <key>match</key>
                <string>^(\[[^\]]+\]).*⁠$</string>
                <key>name</key>
                <string>arduino-output.error</string>
            </dict>
            <dict>
                <key>captures</key>
                <dict>
                    <key>1</key>
                    <dict>
                        <key>name</key>
                        <string>token.warn-token</string>
                    </dict>
                </dict>
                <key>match</key>
                <string>^(\[[^\]]+\]).*‍$</string>
                <key>name</key>
                <string>arduino-output.warning</string>
            </dict>
            <dict>
                <key>captures</key>
                <dict>
                    <key>1</key>
                    <dict>
                        <key>name</key>
                        <string>token.info-token</string>
                    </dict>
                </dict>
                <key>match</key>
                <string>^(\[[^\]]+\]).*[​‌]$</string>
                <key>name</key>
                <string>arduino-output.info</string>
            </dict>
            <!-- Repli : lignes entre crochets sans marqueur (sorties externes). -->
            <dict>
                <key>captures</key>
                <dict>
                    <key>1</key>
                    <dict>
                        <key>name</key>
                        <string>token.info-token</string>
                    </dict>
                </dict>
                <key>match</key>
                <string>^(\[[^\]]+\])</string>
                <key>name</key>
                <string>arduino-output.default</string>
            </dict>
        </array>
    </dict>
</plist>
