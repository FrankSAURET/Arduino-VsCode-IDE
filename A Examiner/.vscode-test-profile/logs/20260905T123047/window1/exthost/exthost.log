r decides when loading specific plugins. See [plugins documentation](https://github.com/hediet/vscode-drawio/blob/master/docs/plugins.md).","scope":"application","order":15},"electropol-fr.drawio-diagrams-editor.customLibraries":{"type":"array","items":{"type":"object","properties":{"entryId":{"type":"string","description":"The id of the entry."},"libName":{"type":"string","description":"The name of the library."}},"anyOf":[{"type":"object","properties":{"url":{"type":"string"}}},{"type":"object","properties":{"xml":{"type":"string"}}},{"type":"object","properties":{"json":{}}},{"type":"object","properties":{"file":{"type":"string","description":"The file path to the library. Must be absolute. You can use ${workspaceFolder}."}}}]},"default":[],"title":"Custom Libraries","description":"Configures the Draw.io editor to use custom libraries.","order":50},"electropol-fr.drawio-diagrams-editor.libraryFolders":{"type":"array","items":{"type":"string"},"default":[],"title":"Library Folders","markdownDescription":"Folders scanned recursively for shape libraries (`.xml` files containing `<mxlibrary>`). Every library found is listed in the **More Shapes** dialog under its file name followed by a star, grouped into one category per folder, and can be switched on or off there like any other shape set. Paths must be absolute; `${workspaceFolder}` is supported.","order":55}}},{"title":"Theme and styles","order":30,"properties":{"electropol-fr.drawio-diagrams-editor.styles":{"title":"Styles","description":"Defines an array of objects that contain the colours (fontColor, fillColor, strokeColor and gradientColor) for the Style tab of the format panel if the selection is empty.","type":"array","items":{"type":"object","properties":{"commonStyle":{"type":"object","properties":{"fontColor":{"type":"string"},"strokeColor":{"type":"string"},"fillColor":{"type":"string"}}},"graph":{"type":"object","properties":{"background":{"type":"string"},"gridColor":{"type":"string"}}}}}},"electropol-fr.drawio-diagrams-editor.defaultVertexStyle":{"title":"Default Vertex Style","description":"Default styling of vertices (shapes).","type":"object"},"electropol-fr.drawio-diagrams-editor.defaultEdgeStyle":{"title":"Default Edge Style","description":"Default styling of edges.","type":"object"},"electropol-fr.drawio-diagrams-editor.colorNames":{"title":"Color Names","description":"Names for colors, eg. {'FFFFFF': 'White', '000000': 'Black'} that are used as tooltips (uppercase, no leading # for the colour codes)","type":"object"},"electropol-fr.drawio-diagrams-editor.presetColors":{"title":"Preset Colors","description":"Color codes for the upper palette in the color dialog.","type":"array","items":{"type":"string"}},"electropol-fr.drawio-diagrams-editor.customColorSchemes":{"title":"Custom Color Schemes","markdownDescription":"Available color schemes in the style section at the top of the format panel.","type":"array","items":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"fill":{"type":"string"},"stroke":{"type":"string"},"gradient":{"type":"string"},"font":{"type":"string"}}}}},"electropol-fr.drawio-diagrams-editor.customFonts":{"type":"array","items":{"type":"string"},"default":[],"title":"Custom Fonts","description":"Configures the Draw.io editor to use custom fonts."},"electropol-fr.drawio-diagrams-editor.theme":{"title":"Draw.io Theme","type":"string","default":"kennedy","enum":["kennedy","min"],"description":"The theme to use for the Draw.io editor. Use \"automatic\" to automatically choose a Draw.io theme that matches your current VS Code theme."},"electropol-fr.drawio-diagrams-editor.appearance":{"title":"Draw.io Appearance","type":"string","default":"light","enum":["automatic","light","dark","high-contrast-light","high-contrast"],"description":"The appearance to use for the Draw.io editor. Use \"automatic\" to automatically choose a Draw.io theme that matches your current VS Code theme."}}}],"menus":{"explorer/context":[{"when":"electropol-fr.drawio-diagrams-editor.active","command":"electropol-fr.drawio-diagrams-editor.linkFileWithSelectedNode","group":"Draw.io"}],"commandPalette":[{"when":"false","command":"electropol-fr.drawio-diagrams-editor.linkFileWithSelectedNode"},{"when":"isWindows","command":"electropol-fr.drawio-diagrams-editor.associateFileType"}],"editor/title":[{"command":"electropol-fr.drawio-diagrams-editor.openAsText","when":"activeCustomEditorId == 'electropol-fr.drawio-diagrams-editor-text' || activeCustomEditorId == 'electropol-fr.drawio-diagrams-editor'","group":"navigation"},{"command":"electropol-fr.drawio-diagrams-editor.openAsDiagram","when":"!activeCustomEditorId && resourceFilename =~ /\\.(drawio|dio)(\\.svg|\\.png)?$/","group":"navigation"}]}},"scripts":{"vscode:prepublish":"yarn build-extension && yarn build-plugins","run-script":"node ./scripts/run-script","lint":"echo 'add linting'","_lint":"yarn run-script check-version && prettier --check ./src","build":"yarn build-extension && yarn build-plugins && yarn package-extension","build-extension":"webpack --mode production","build-plugins":"webpack --mode production --config ./drawio-custom-plugins/webpack.config.ts","package-extension":"yarn package-extension-stable","package-extension-stable":"node ./scripts/package-vsix.mjs","package-extension-preRelease":"node ./scripts/package-vsix.mjs --pre-release","dev":"webpack --mode development --watch","dev-drawio-plugins":"webpack --mode development --watch --config ./drawio-custom-plugins/webpack.config.ts","dev-drawio-plugins-web":"webpack-dev-server --hot --config ./drawio-custom-plugins/webpack.config.ts"},"devDependencies":{"@actions/exec":"^1.0.4","@actions/github":"^2.2.0","@hediet/semver":"^0.2.1","@types/copy-webpack-plugin":"^8.0.1","@types/mithril":"^2.0.4","@types/node":"^22.10.10","@types/vscode":"1.73.0","@types/xml-formatter":"^1.1.0","@vscode/vsce":"^3.2.1","clean-webpack-plugin":"^4.0.0-alpha.0","copy-webpack-plugin":"^9.0.1","css-loader":"^3.4.2","ovsx":"^0.1.0-next.e000fdb","prettier":"^2.3.2","raw-loader":"^4.0.1","style-loader":"^1.1.3","ts-loader":"^9.2.3","ts-node":"^10.1.0","typescript":"^5.7.3","webpack":"^5.44.0","webpack-cli":"^4.7.2","webpack-dev-server":"^3.11.2"},"dependencies":{"@hediet/json-to-dictionary":"^0.2.1","@hediet/std":"0.6.0","@knuddels/mobx-logger":"^1.1.1","buffer":"^6.0.3","js-sha256":"^0.9.0","mithril":"^2.0.4","mobx":"5.15.4","mobx-utils":"5.5.7","path-browserify":"^1.0.1","vsls":"^1.0.3015","xml-formatter":"^2.0.1","xml-parser-xo":"^3.0.0"}},{"id":"electropol-fr.kablix","identifier":{"value":"electropol-fr.kablix","_lower":"electropol-fr.kablix"},"isBuiltin":false,"isUserBuiltin":false,"isUnderDevelopment":false,"extensionLocation":{"$mid":1,"fsPath":"c:\\Users\\Frank\\.vscode\\extensions\\electropol-fr.kablix-2026.9.1","_sep":1,"path":"/c:/Users/Frank/.vscode/extensions/electropol-fr.kablix-2026.9.1","scheme":"file"},"uuid":"eebcb537-90a4-4c3d-9bf7-e50f7fc9ef9b","targetPlatform":"undefined","publisherDisplayName":"electropol.fr","preRelease":false,"name":"kablix","displayName":"Kablix","version":"2026.9.1","buildNumber":47,"description":"A microcontroller simulator (Arduino Uno / Raspberry Pi Pico) right inside VS Code, 100% offline.","publisher":"electropol-fr","author":{"name":"electropol.fr","url":"https://electropol.fr"},"license":"MIT","icon":"media/icon.png","repository":{"type":"git","url":"https://github.com/FrankSAURET/kablix"},"bugs":{"url":"https://github.com/FrankSAURET/kablix/issues"},"homepage":"https://github.com/FrankSAURET/kablix#readme","engines":{"vscode":"^1.85.0"},"categories":["Education","Visualization","Other"],"keywords":["arduino","raspberry pi pico","microcontroller","simulator","simulation","rp2040","rp2350","avr","offline"],"main":"./dist/extension.js","activationEvents":[],"contributes":{"commands":[{"command":"kablix.openSimulator","title":"Kablix: Open the simulator","category":"Kablix"},{"command":"kablix.compileAndRun","title":"Kablix: Compile","category":"Kablix"},{"command":"kablix.loadWorkspaceArtifact","title":"Kablix: Load the compiled artifact of the workspace","category":"Kablix"},{"command":"kablix.saveProject","title":"Kablix: Save project (.projix)","category":"Kablix"},{"command":"kablix.saveProjectSmart","title":"Kablix: Save project (smart name)","category":"Kablix"},{"command":"kablix.openProject","title":"Kablix: Open project (.projix)","category":"Kablix"},{"command":"kablix.exportWokwiDiagram","title":"Kablix: Export the Wokwi diagram (diagram.json)","category":"Kablix"},{"command":"kablix.importWokwiDiagram","title":"Kablix: Import a Wokwi diagram (diagram.json)","category":"Kablix"},{"command":"kablix.exportPartsCsv","title":"Kablix: Export the part list (CSV)","category":"Kablix"},{"command":"kablix.checkLibraryUpdates","title":"Kablix: Check for library updates","category":"Kablix"},{"command":"kablix.upgradePicoFirmware","title":"Kablix: Upgrade Pico firmware","category":"Kablix"},{"command":"kablix.openHelp","title":"Kablix: Help","category":"Kablix"},{"command":"kablix.saveDefaultLayout","title":"Kablix: Save the default layout","category":"Kablix"},{"command":"kablix.rearrangeLayout","title":"Kablix: Rearrange the windows","category":"Kablix"},{"command":"kablix.associateProjix","title":"Kablix: Associate .projix files with Kablix","category":"Kablix"},{"command":"kablix.fixIntelliSense","title":"Kablix: Fix code analysis for this board","category":"Kablix"},{"command":"kablix.recommendedExtensions","title":"Kablix: Recommended extensions","category":"Kablix"},{"command":"kablix.chooseSvgEditor","title":"Kablix: Choose the SVG editor…","category":"Kablix"},{"command":"kablix.openComponentsFolder","title":"Kablix: Open the components library","category":"Kablix"},{"command":"kablix.openComponentManager","title":"Kablix: Manage components","category":"Kablix"},{"command":"kablix.uploadToPico","title":"Kablix: Send the program to the Pico board","category":"Kablix","icon":"media/upload.svg"},{"command":"kablix.uploadToPicoOffline","title":"Kablix: Send the program to the Pico board (no board detected)","category":"Kablix","icon":"media/upload-inactive.svg"}],"keybindings":[{"command":"kablix.saveProjectSmart","key":"ctrl+s","mac":"cmd+s","when":"activeCustomEditorId == 'kablix.projix'"}],"menus":{"editor/title":[{"command":"kablix.uploadToPico","group":"navigation@-3","when":"resourceLangId == python && kablix.picoConnected"},{"command":"kablix.uploadToPicoOffline","group":"navigation@-3","when":"resourceLangId == python && !kablix.picoConnected"}],"commandPalette":[{"command":"kablix.uploadToPicoOffline","when":"false"}]},"viewsContainers":{"activitybar":[{"id":"kablix","title":"Kablix","icon":"media/activity-icon.png"}]},"views":{"kablix":[{"id":"kablix.home","name":"Simulator"}]},"viewsWelcome":[{"view":"kablix.home","contents":"[▶ Open the simulator](command:kablix.openSimulator)"}],"customEditors":[{"viewType":"kablix.projix","displayName":"Kablix simulator","selector":[{"filenamePattern":"*.projix"}],"priority":"default"}],"configuration":{"title":"Kablix","properties":{"kablix.micropythonUf2":{"type":"string","default":"","description":"Path (absolute or workspace-relative) of the MicroPython .uf2 firmware used to run .py files on the simulated Pico. Leave empty: Kablix auto-detects a firmware in the workspace, and otherwise offers to download the official firmware on first run."},"kablix.checkUpdatesOnStartup":{"type":"boolean","default":false,"description":"Check the npm registry once at startup for newer versions of the bundled simulation libraries. Off by default (Kablix is offline by default); when on, a notification only appears if an update exists. You can also run the check manually with the \"Kablix: Check for library updates\" command."},"kablix.simulationWorker":{"type":"boolean","default":true,"description":"Run the simulation engine (Arduino and Pico alike) in a background thread, so panning, zooming and editing stay smooth while a program runs, and so a heavy page never makes the simulated clock fall behind. On by default: pin readings then come from a snapshot refreshed every 4 ms instead of the engine itself, which is invisible on screen. Turn it off to keep the engine on the main thread — Kablix also falls back there on its own if the background thread cannot start."},"kablix.checkFirmwareUpdatesOnStartup":{"type":"boolean","default":false,"description":"Check once at startup whether the cached MicroPython firmware (.uf2) for the simulated Pico matches the version bundled with this Kablix release, and offer to upgrade it if not. Off by default; when on, a notification only appears if an upgrade is available. You can also run the upgrade manually with the \"Kablix: Upgrade Pico firmware\" command."},"kablix.restoreLastProjectOnStartup":{"type":"boolean","default":true,"description":"Reopen the last Kablix project (.projix) that was open when VS Code closed, in the simulator, on startup. On by default. Other text tabs (including the associated code file) are restored natively by VS Code."},"kablix.arduinoCliPath":{"type":"string","default":"","description":"Full path to the arduino-cli executable (or the folder containing it). Set this if Kablix reports arduino-cli as missing even though it is installed (e.g. it is not on the PATH seen by VS Code). Leave empty to auto-detect via the PATH and common install locations."},"kablix.toolchainPath":{"type":"string","default":"","description":"Extra folder searched for the compilation tools (arduino-cli, avr-gcc, arm-none-eabi-gcc, objcopy, objdump). Useful for a portable toolchain that is not on the PATH. Leave empty to use the PATH only."},"kablix.showLoadBinaryButton":{"type":"boolean","default":false,"description":"Show the \"Load binary\" button in the simulator toolbar (loads an already-compiled .hex/.uf2 from the workspace without recompiling). Hidden by default."},"kablix.showResetPartsButton":{"type":"boolean","default":false,"description":"Show the \"Reset all components\" button (⟲) in the canvas toolbar: it puts every part back to its idle state (switches released, sliders at rest) without touching the wiring. Hidden by default."},"kablix.showClearDiagramButton":{"type":"boolean","default":false,"description":"Show the \"Clear the diagram\" button (eraser) in the canvas toolbar: it removes every part and wire at once (Ctrl+Z undoes it). Hidden by default."},"kablix.picowNetworkBridge":{"type":"boolean","default":true,"description":"Pico W: let MicroPython scripts make REAL HTTP requests (network/urequests) tunneled through the host (the Wi-Fi chip is not emulated). The host performs the actual fetch and returns the response to the script. On by default; turn off to block all outbound requests from simulated scripts."},"kablix.selectionColor":{"type":"string","default":"#e973e9","pattern":"^#[0-9a-fA-F]{6}$","description":"Selection color (parts, wires, bends). Any #rrggbb hex color. Kept vivid by default so it stays visible on all themes."},"kablix.svgEditorPath":{"type":"string","default":"","description":"Full path of the SVG editor (Inkscape, Illustrator…) used by \"Open in the SVG editor\" in the part creator. Empty: Kablix looks up the application your system associates with .svg files, writes it here, and asks you nothing. It only opens the picker when it finds no editor at all."},"kablix.syncArduinoIdeBoard":{"type":"boolean","default":true,"description":"Selecting an Arduino board in Kablix also selects it in the \"Arduino VS Code IDE\" extension, so your .ino sketch is recognized (IntelliSense, compilation, upload) without picking the board twice. Writes the board into .vscode/arduino.yaml, and only when that file or an .ino sketch already exists in the folder. Pico boards never touch it. On by default."},"kablix.syncIntelliSense":{"type":"boolean","default":true,"description":"Keeps code analysis valid for the board picked in Kablix, so nothing is underlined for the wrong reason. On an .ino sketch, asks \"Arduino VS Code IDE\" to rebuild its IntelliSense configuration for that board (Serial, pinMode... stop being unknown). On a Pico program, points Pylance at the MicroPython declarations shipped with the MicroPico extension, in the workspace folder settings (machine, neopixel, rp2... stop being unresolved imports). Only adds what is missing, never overwrites your own settings, and does nothing when the matching extension is not installed. On by default."},"kablix.showArduinoOutput":{"type":"boolean","default":false,"description":"Shows the Arduino output panel while Kablix sets up code analysis for an .ino sketch. Off by default: picking a board is not a build, so the panel that the \"Arduino VS Code IDE\" extension opens on every compilation is closed again right away, and once more when it re-analyses on its own a few seconds later. The Verify and Upload buttons are never touched: their output shows as usual. Turn it on to watch what the Arduino extension is doing."},"kablix.componentsFolder":{"type":"string","default":"","markdownDescription":"Folder where your custom components (.kompix) are stored. Shared by all Kablix projects on this machine. Change it if you prefer a custom location.\n\nEmpty (default): a subfolder of VS Code's global storage —\n- Windows: `%APPDATA%\\Code\\User\\globalStorage\\electropol-fr.kablix\\kablix_components`\n- macOS: `~/Library/Application Support/Code/User/globalStorage/electropol-fr.kablix/kablix_components`\n- Linux: `~/.config/Code/User/globalStorage/electropol-fr.kablix/kablix_components`\n\nThe command **Kablix: Open the components library** opens the folder currently in use, wherever it is."},"kablix.componentRepositories":{"type":"array","items":{"type":"string"},"default":["https://raw.githubusercontent.com/FrankSAURET/kablix/main/kablix_components/"],"description":"List of remote repositories (URLs) where .kompix components can be downloaded from. By default, points to the official Kablix library on GitHub."}}}},"scripts":{"vscode:prepublish":"npm run build","postinstall":"patch-package","build":"node esbuild.js --production","watch":"node esbuild.js --watch","build:firmware":"node scripts/build-firmware.mjs","build:parts":"node scripts/build-parts.mjs","build:testplan":"node scripts/make-test-plan.mjs","profil":"node scripts/_extract-profils.mjs","assemblage":"node scripts/_extract-assemblage.mjs","montre":"node scripts/montre.mjs","typecheck":"tsc --noEmit","verify":"node scripts/verify-sim.mjs","verify:compiler":"node scripts/verify-compiler.mjs","verify:diagram":"node scripts/verify-diagram.mjs","verify:uf2":"node scripts/verify-uf2.mjs","verify:firmware":"node scripts/verify-firmware.mjs","verify:updates":"node scripts/verify-updates.mjs","verify:decode":"node scripts/verify-decode.mjs","verify:micropython":"node scripts/verify-micropython.mjs","verify:wokwi":"node scripts/verify-wokwi.mjs","verify:net":"node scripts/verify-net.mjs","verify:equipot":"node scripts/verify-equipot.mjs","verify:i2c":"node scripts/verify-i2c.mjs","verify:components":"node scripts/verify-components.mjs","verify:spi":"node scripts/verify-spi-dma-unit.mjs && node scripts/verify-spi.mjs","verify:neopixel":"node scripts/verify-neopixel.mjs","verify:ledring":"node scripts/verify-ledring.mjs","verify:creator":"node scripts/verify-creator.mjs","verify:debug":"node scripts/verify-debug-py.mjs","verify:debugavr":"node scripts/verify-debug-avr.mjs","verify:arduinoide":"node scripts/verify-arduinoide.mjs","verify:intellisense":"node scripts/verify-intellisense.mjs","verify:kompix":"node scripts/verify-kompix.mjs","verify:opendrain":"node scripts/verify-opendrain.mjs","verify:libpalette":"node scripts/verify-lib-palette.mjs","verify:kompixhelp":"node scripts/verify-kompix-help.mjs","verify:projixparts":"node scripts/verify-projix-parts.mjs","verify:picoupload":"node scripts/verify-picoupload.mjs","verify:pico2":"node scripts/verify-pico2.mjs --target=rp2040 && node scripts/verify-pico