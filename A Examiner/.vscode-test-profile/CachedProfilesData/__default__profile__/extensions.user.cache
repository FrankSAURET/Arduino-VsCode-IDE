Markdown for Humans","selector":[{"filenamePattern":"*.md","scheme":"file"},{"filenamePattern":"*.markdown","scheme":"file"},{"filenamePattern":"*.md","scheme":"untitled"},{"filenamePattern":"*.markdown","scheme":"untitled"}],"priority":"option"}],"commands":[{"command":"markdownForHumans.openFile","title":"Open with Markdown for Humans"},{"command":"markdownForHumans.outline.revealCurrent","title":"Outline: Reveal Current Heading","icon":"$(target)"},{"command":"markdownForHumans.outline.filter","title":"Outline: Filter Headings","icon":"$(search)"},{"command":"markdownForHumans.outline.clearFilter","title":"Outline: Clear Filter","icon":"$(close)"},{"command":"markdownForHumans.copyAiContextRef","title":"Markdown for Humans: Copy AI Context Reference (@file#lines)"},{"command":"markdownForHumans.toggleFormattingShortcuts","title":"Markdown for Humans: Toggle Formatting Shortcuts (Cmd/Ctrl+B/I/U)"}],"keybindings":[{"command":"markdownForHumans.copyAiContextRef","key":"alt+c","mac":"alt+c","when":"activeCustomEditorId == 'markdownForHumans.editor'"},{"command":"markdownForHumans.toggleFormattingShortcuts","key":"ctrl+alt+b","mac":"cmd+alt+b","when":"activeCustomEditorId == 'markdownForHumans.editor'"}],"views":{"explorer":[{"id":"markdownForHumansOutline","name":"Markdown for Humans: Outline","when":"markdownForHumans.isActive"}]},"menus":{"explorer/context":[{"command":"markdownForHumans.openFile","when":"resourceExtname == .md","group":"navigation"}],"editor/title/context":[{"command":"markdownForHumans.openFile","when":"resourceExtname == .md && activeCustomEditorId != 'markdownForHumans.editor'","group":"navigation"}],"view/title":[{"command":"markdownForHumans.outline.revealCurrent","when":"view == markdownForHumansOutline","group":"navigation@1"},{"command":"markdownForHumans.outline.filter","when":"view == markdownForHumansOutline && !markdownForHumans.outlineFilterActive","group":"navigation@2"},{"command":"markdownForHumans.outline.clearFilter","when":"view == markdownForHumansOutline && markdownForHumans.outlineFilterActive","group":"navigation@2"}]},"configuration":{"title":"Markdown for Humans","properties":{"markdownForHumans.imagePath":{"type":"string","default":"images","description":"Folder path for saved images. Interpreted relative to markdownForHumans.imagePathBase."},"markdownForHumans.imagePathBase":{"type":"string","enum":["relativeToDocument","workspaceFolder"],"default":"relativeToDocument","description":"Controls whether Image Path is relative to the current markdown file folder or the workspace folder."},"markdownForHumans.chromePath":{"type":"string","default":"","markdownDescription":"Path to Google Chrome or Chromium executable for PDF export. Leave empty to auto-detect.\n\n**Download Chrome:**\n- [Windows/Mac/Linux](https://www.google.com/chrome/)\n- [Chromium (open source)](https://www.chromium.org/getting-involved/download-chromium/)\n\n**Common paths:**\n- **Mac:** `/Applications/Google Chrome.app/Contents/MacOS/Google Chrome`\n- **Windows:** `C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe`\n- **Linux:** `/usr/bin/google-chrome` or `/usr/bin/chromium`"},"markdownForHumans.imageResize.skipWarning":{"type":"boolean","default":false,"description":"Skip the warning dialog when resizing images. When enabled, images will be resized immediately without confirmation."},"markdownForHumans.copyAiContextRef.skipSaveWarning":{"type":"boolean","default":false,"description":"Skip the warning dialog when 'Copy AI Context Reference' needs to save the file first. When enabled, the document is saved silently before copying the reference."},"markdownForHumans.blankLines.mode":{"type":"string","enum":["preserve","strip"],"default":"strip","description":"Controls whether extra blank lines are preserved or removed in the editor and saved file."},"markdownForHumans.imagePreview.hover.enabled":{"type":"boolean","default":true,"description":"Enable the image hover overlay that shades images and displays metadata (resolution, file size, etc.) on hover.","scope":"application"},"markdownForHumans.paragraph.spacingBefore":{"type":"number","default":0,"minimum":0,"maximum":72,"description":"Space before paragraphs in points (margin-top). Default: 0pt","scope":"application"},"markdownForHumans.paragraph.spacingAfter":{"type":"number","default":0,"minimum":0,"maximum":72,"description":"Space after paragraphs in points (margin-bottom). Default: 0pt","scope":"application"},"markdownForHumans.zoom":{"type":"number","default":100,"minimum":50,"maximum":200,"description":"Zoom level for the editor as a percentage. 100 = default size, 150 = 50% larger, etc.","scope":"application"},"markdownForHumans.enableMath":{"type":"boolean","default":true,"description":"Render LaTeX math expressions using KaTeX. Use $...$ for inline math and $$...$$ for display math. Toggling this setting requires reopening the editor."},"markdownForHumans.formattingShortcuts.enabled":{"type":"boolean","default":true,"description":"When enabled, Cmd/Ctrl+B, +I, and +U toggle bold/italic/underline inside the editor. Disable this if you rely on VS Code keybindings that use the same chords (e.g. a sidebar toggle rebound to Cmd+B) and want them to keep working while a markdown file is open in this editor.","scope":"application"}}}},"scripts":{"vscode:prepublish":"npm run build:release","build:debug":"npm run build:extension:debug && npm run build:webview:debug","build:release":"npm run build:extension:release && npm run build:webview:release && npm run verify-build","verify-build":"node scripts/verify-build.js","build:extension:debug":"node scripts/build-extension.js","build:extension:release":"node scripts/build-extension.js --prod --no-sourcemap","build:webview:debug":"node scripts/build-webview.js","build:webview:release":"node scripts/build-webview.js --prod --no-sourcemap","watch:debug":"concurrently \"npm run watch:extension:debug\" \"npm run watch:webview:debug\"","watch:extension:debug":"node scripts/buil