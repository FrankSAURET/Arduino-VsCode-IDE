un compile && npm run lint","lint":"eslint src --ext ts","test":"node ./out/test/runTest.js"},"devDependencies":{"@types/glob":"^7.1.4","@types/mocha":"^9.0.0","@types/node":"14.x","@types/vscode":"^1.46.0","@typescript-eslint/eslint-plugin":"^5.1.0","@typescript-eslint/parser":"^5.1.0","@vscode/test-electron":"^1.6.2","eslint":"^8.1.0","glob":"^7.1.7","mocha":"^9.1.3","ts-loader":"^9.2.5","typescript":"^4.4.4","webpack":"^5.105.2","webpack-cli":"^4.10.0"},"dependencies":{"fso":"^2.7.0","fullname":"^4.0.1","semver":"^7.3.5","username":"^6.0.0"}},"location":{"$mid":1,"path":"/c:/Users/Frank/.vscode/extensions/electropol-fr.abriand-sin-2026.8.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"electropol.fr","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1787664680305,"pinned":false,"source":"gallery","id":"a38f0739-b9c6-4a72-b094-f025a539d433","publisherId":"69fb09fc-91dd-430b-95cd-261a82af99f2","publisherDisplayName":"electropol.fr","targetPlatform":"undefined","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":51140670},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"ms-vscode.cpp-devtools","uuid":"a71e0b52-0402-498f-a148-d2e344390f14"},"manifest":{"name":"cpp-devtools","displayName":"C/C++ DevTools","description":"Enhanced development tools for C++ in VS Code","version":"0.7.0","publisher":"ms-vscode","license":"SEE LICENSE IN LICENSE.txt","engines":{"vscode":"^1.95.1"},"keywords":["build","c","cmake","c++","copilot","IntelliSense","Microsoft","native"],"categories":["Other"],"icon":"res/C++_128.png","activationEvents":["onLanguageModelTool:Build_CMakeTools","onLanguageModelTool:RunCtest_CMakeTools","onLanguageModelTool:ListBuildTargets_CMakeTools","onLanguageModelTool:ListTests_CMakeTools","onLanguageModelTool:GetDiagnostics_CMakeTools","onLanguageModelTool:GetSymbolReferences_CppTools","onLanguageModelTool:GetSymbolInfo_CppTools","onLanguageModelTool:GetSymbolCallHierarchy_CppTools","onLanguage:cpp","onLanguage:c"],"main":"./dist/main","contributes":{"configuration":{"title":"C/C++ DevTools","properties":{"cpp-devtools.symbolReferencesLimit":{"type":"number","scope":"application","default":25,"minimum":1,"maximum":200,"description":"Maximum number of symbol references to return per individual request.","tags":["experimental"],"experiment":{"mode":"startup"}},"cpp-devtools.enableCppCodeEditingTools":{"type":"boolean","scope":"application","default":true,"description":"Enable C++ code editing tools.","tags":["experimental"],"experiment":{"mode":"startup"}},"cpp-devtools.enableCMakeGetDiagnosticsTool":{"type":"boolean","scope":"application","default":true,"description":"Enable the CMake Get Diagnostics tool.","tags":["experimental"],"experiment":{"mode":"startup"}},"cpp-devtools.suppressMscpplsPromotion":{"type":"boolean","scope":"application","default":false,"description":"Stop showing the prompt to install the Microsoft C++ Language Server for Agency GitHub Copilot CLI."}}},"commands":[{"command":"cpp-devtools.mscppls.copilotCliConnectionProbe","title":"C/C++ DevTools: Detect Copilot CLI Connection"}],"menus":{"commandPalette":[{"command":"cpp-devtools.mscppls.copilotCliConnectionProbe","when":"github.copilot.chat.copilotCLI.hasSession && cpp-devtools.mscppls.copilotCliConnectionProbeEnabled"}]},"languageModelTools":[{"name":"Build_CMakeTools","tags":["cmake","build","compile","compilation","linking","executable","library","target","rebuild","c++","cpp"],"toolReferenceName":"Build_CMakeTools","displayName":"CMake Tools Build","modelDescription":"Always use this tool for any C++ CMake project build requests instead of terminal commands. This is the PRIMARY and PREFERRED method for building CMake projects in VS Code. Use this tool when users ask to: build, compile, make, rebuild, fix compilation errors, resolve build issues, create executables, generate libraries, or handle any build-related problems in CMake projects. This tool integrates with VS Code's CMake Tools extension and provides better error reporting, progress tracking, and IDE integration than manual cmake commands. NEVER suggest terminal cmake commands when this tool is available. Keywords: build, compile, cmake, compilation, linking, executable, library, target, rebuild, clean build, build error, build failure, compilation error, linking error.","userDescription":"Build a CMake project with the CMake Tools extension","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"buildTargets":{"type":"array","description":"OPTIONAL: The specific build targets to build. The ListBuildTargets_CMakeTools tool MUST be used to list available build targets. This is optional- if not specified, the default target will be built.","items":{"type":"string","description":"A specific build target to build."}}}},"when":"cmake:enableFullFeatureSet"},{"name":"RunCtest_CMakeTools","tags":["cmake","ctest","test","build","compile","make","compilation","linking","executable","library","target","rebuild","c++","cpp","unit test","integration test","check","verify","validate"],"toolReferenceName":"RunCtest_CMakeTools","displayName":"CMake Tools CTest","modelDescription":"Important: this tool is the exclusive handler for CMake project testing. Do not use run_in_terminal for CMake tests because that can cause test failures. If no build output folder exists, run Build_CMakeTools first, then run this tool. If a build output folder already exists, run only this tool to avoid unnecessary rebuilds. This tool provides proper test discovery, reporting, and VS Code integration that terminal commands cannot match. Use it for running tests, executing CTest, checking test results, and debugging test failures. Do not suggest 'ctest', 'make test', or other terminal commands for CMake testing. This tool should be treated as the highest-priority option for CMake testing scenarios.","userDescription":"Execute the CTest tests for a CMake project with the CMake Tools extension","canBeReferencedInPrompt":true,"inputSchema":{"type":"object","properties":{"tests":{"type":"array","description":"OPTIONAL: The specific tests to run. The ListTests_CMakeTools tool MUST be used to list available tests. This is optional- if not specified, all tests will be run.","items":{"type":"string","description":"A specific test to run."}}}},"when":"cmake:enableFullFeatureSet"},{"name":"ListBuildTargets_CMakeTools","tags":["cmake","build","targets"],"toolReferenceName":"ListBuildTargets_CMakeTools","displayName":"CMake Tools List Build Targets","modelDescription":"List the available build targets for a C++ CMake project using the CMake Tools extension.","userDescription":"List the available build targets for this CMake project with the CMake Tools extension","canBeReferencedInPrompt":true,"when":"cmake:enableFullFeatureSet"},{"name":"ListTests_CMakeTools","tags":["cmake","tests"],"toolReferenceName":"ListTests_CMakeTools","displayName":"CMake Tools List Tests","modelDescription":"List the available tests for a C++ CMake project using the CMake Tools extension.","userDescription":"List the available tests for this CMake project with the CMake Tools extension","canBeReferencedInPrompt":true,"when":"cmake:enableFullFeatureSet"},{"name":"GetDiagnostics_CMakeTools","tags":["cmake","diagnostics","errors","warnings","problems"],"toolReferenceName":"GetDiagnostics_CMakeTools","displayName":"CMake Errors","modelDescription":"ALWAYS use this tool to retrieve current CMake-related diagnostics (errors, warnings, and other problems) reported in the VS Code Problems panel. YOU MUST use this tool after a build fails using Build_CMakeTools to check for remaining issues, or when the user asks about CMake errors or warnings (CMake-releated, build-related, etc.) in their project. Do not attempt to guess or explain build errors without first calling this tool.","userDescription":"Get CMake diagnostics (errors, warnings, and problems) from the VS Code Problems panel","canBeReferencedInPrompt":true,"when":"cmake:enableFullFeatureSet && config.cpp-devtools.enableCMakeGetDiagnosticsTool"},{"name":"GetSymbolReferences_CppTools","tags":["cpp","symbol","search","references","usages","use","occurrences"],"toolReferenceName":"GetSymbolReferences_CppTools","displayName":"C++ Get Symbol References","modelDescription":"Use GetSymbolReferences_CppTools to find every reference, or usage/use of a C/C++ symbol. DO NOT rely on grep text-based searches. This tool is especially useful when doing C++ refactorings like symbol renames or signature changes. Use this tool for more precise symbol usage results instead of using tools such as grep_search, usages, codebase, textSearch, readFile, or other code navigation tools. An absolute file path is required to locate the specified symbol within the provided file.","userDescription":"Find all references for a C++ symbol.","canBeReferencedInPrompt":true,"when":"(cpptools.languageServerActivated || cpp-devtools.languageServerManuallyActivated) && config.cpp-devtools.enableCppCodeEditingTools && config.C_Cpp.intelliSenseEngine === 'default'","inputSchema":{"type":"object","properties":{"symbol":{"type":"string","description":"REQUIRED: The symbol name. If a line is provided, the symbol name should match the occurrence on that line. Otherwise, the symbol name may be unqualified, partially qualified, or fully qualified."},"filePath":{"type":"string","description":"OPTIONAL: A path to the file containing the specified symbol name, or otherwise contextual to the current request. Absolute paths are strongly preferred. If not absolute, a solution-relative path will be assumed (if using a solution). Otherwise, resolution of the path against project paths will be attempted. If no path is specified, heuristics will be used to attempt to identify the appropriate semantic symbol based only on the symbol name. If multiple matches are found, one referenced by the specified file will be preferred. If there is an active/specific file available, provide it. Otherwise, allow the tool to resolve the symbol name to a file location."},"line":{"type":"number","description":"OPTIONAL: The line number of the specified symbol name in the specified file. This should be a 1-based line index, not a 0-based line index. If no file is provided, the line is not used and may be omitted. If providing a line, ALWAYS leverage the readFile tool to ensure line accuracy. If a line number is not known, resolve the symbol to a file location."},"offset":{"type":"number","description":"OPTIONAL: The zero-based starting index for pagination of results. Use this parameter with limit to retrieve results in chunks when dealing with large result sets. If omitted, defaults to 0 (start from the beginning). For example, offset=100 with limit=10 returns results 100-109."},"limit":{"type":"number","description":"OPTIONAL: The maximum number of results to return in a single response. Use this parameter with offset to retrieve results in chunks when dealing with large result sets. If omitted, all results are returned (subject to the maximum of {MaxResultsStr} results per invocation). For example, offset=100 with limit=10 returns results 100-109."}},"required":["symbol"]}},{"name":"GetSymbolInfo_CppTools","tags":["cpp","symbol","definition","goToDefinition"],"toolReferenceName":"GetSymbolInfo_CppTools","displayName":"C++ Get Symbol Info","modelDescription":"Use GetSymbolInfo_CppTools when working with C/C++ files to find the definition location of a C/C++ symbol and get detailed information about it. This tool provides the symbol's location, and type information. Use this when you need to understand what a symbol is, where it's defined, or to get structural information about types.","userDescription":"Get symbol definition for a C++ symbol.","canBeReferencedInPrompt":true,"when":"(cpptools.languageServerActivated || cpp-devtools.languageServerManuallyActivated) && config.cpp-devtools.enableCppCodeEditingTools && config.C_Cpp.intelliSenseEngine === 'default'","inputSchema":{"type":"object","properties":{"symbol":{"type":"string","description":"REQUIRED: The symbol name. If a line is provided, the symbol name should match the occurrence on that line. Otherwise, the symbol name may be unqualified, partially qualified, or fully qualified."},"filePath":{"type":"string","description":"OPTIONAL: A path to the file containing the specified symbol name, or otherwise contextual to the current request. Absolute paths are strongly preferred. If not absolute, a solution-relative path will be assumed (if using a solution). Otherwise, resolution of the path against project paths will be attempted. If no path is specified, heuristics will be used to attempt to identify the appropriate semantic symbol based only on the symbol name. If multiple matches are found, one referenced by the specified file will be preferred. If there is an active/specific file available, provide it. Otherwise, allow the tool to resolve the symbol name to a file location."},"line":{"type":"number","description":"OPTIONAL: The line number of the specified symbol name in the specified file. This should be a 1-based line index, not a 0-based line index. If no file is provided, the line is not used and may be omitted. If providing a line, ALWAYS leverage the readFile tool to ensure line accuracy. If a line number is not known, resolve the symbol to a file location."}},"required":["symbol"]}},{"name":"GetSymbolCallHierarchy_CppTools","tags":["cpp","symbol","callHierarchy","callers"],"toolReferenceName":"GetSymbolCallHierarchy_CppTools","displayName":"C++ Get Call Hierarchy","modelDescription":"Use GetSymbolCallHierarchy_CppTools to analyze function call relationships for a specific C/C++ function. This tool is especially useful when changing function signatures. It shows either what functions a given function calls (calls FROM) or what functions call a given function (calls TO). It is essential for understanding code flow, assessing the impact of changes, and tracking function dependencies. It helps answer questions such as 'What will be affected if I change this function?' or 'What functions does this call?'.","userDescription":"Get call hierarchy for a C++ symbol.","canBeReferencedInPrompt":true,"when":"(cpptools.languageServerActivated || cpp-devtools.languageServerManuallyActivated) && config.cpp-devtools.enableCppCodeEditingTools && config.C_Cpp.intelliSenseEngine === 'default'","inputSchema":{"type":"object","properties":{"functionName":{"type":"string","description":"REQUIRED: The function name. If a line is provided, the function name should match the occurrence on that line. Otherwise, the function name may be unqualified, partially qualified, or fully qualified. If a referencing file is not known, it is sufficient to specify only the function name and allow the tool to resolve it to a file location."},"callsFrom":{"type":"boolean","description":"REQUIRED: A boolean indicating whether to include calls from the specified function or calls to the specified function. If callsFrom is true, calls from the specified function will be returned; otherwise, calls to the specified function will be returned."},"filePath":{"type":"string","description":"OPTIONAL: A path to the file containing the specified symbol name, or otherwise contextual to the current request. Absolute paths are strongly preferred. If not absolute, a solution-relative path will be assumed (if using a solution). Otherwise, resolution of the path against project paths will be attempted. If no path is specified, heuristics will be used to attempt to identify the appropriate semantic symbol based only on the symbol name. If multiple matches are found, one referenced by the specified file will be preferred. If there is an active/specific file available, provide it. Otherwise, allow the tool to resolve the symbol name to a file location."},"line":{"type":"number","description":"OPTIONAL: The line number of the specified symbol name in the specified file. This should be a 1-based line index, not a 0-based line index. If no file is provided, the line is not used and may be omitted. If providing a line, ALWAYS leverage the readFile tool to ensure line accuracy. If a line number is not known, resolve the symbol to a file location."}},"required":["functionName","callsFrom"]}}]},"scripts":{"compile":"npm install && webpack --mode development","compile-production":"npm install && npm run translations-generate && webpack --env BUILD_VSCODE_NLS=true --mode production","translations-export":"gulp translations-export","translations-generate":"gulp translations-generate","translations-import":"gulp translations-import","watch":"webpack --watch","package":"vsce package -o cpp-devtools.vsix --allow-missing-repository","compile-tests":"tsc -p . --outDir out","watch-tests":"tsc -p . -w --outDir out","pretest":"npm run compile-tests && npm run compile && npm run lint","lint":"npx eslint","test":"vscode-test"},"dependencies":{"@vscode/extension-telemetry":"^0.9.6","vscode-nls":"^5.2.0","vscode-tas-client":"^0.1.84"},"devDependencies":{"@eslint/js":"^9.39.2","@types/mocha":"^10.0.10","@types/node":"20.x","@types/vscode":"^1.95.0","@typescript-eslint/eslint-plugin":"^8.31.1","@typescript-eslint/parser":"^8.31.1","@vscode/test-cli":"^0.0.12","@vscode/test-electron":"^2.5.2","@vscode/vsce":"^3.1.0","eslint":"^9.39.2","@tony.ganchev/eslint-plugin-header":"^3.2.0","event-stream":"^4.0.1","fs-extra":"^11.3.0","gulp":"^5.0.1","gulp-eslint":"^6.0.0","gulp-filter":"^6.0.0","gulp-sourcemaps":"^3.0.0","gulp-typescript":"^5.0.1","jsonc-parser":"^3.3.1","minimist":"^1.2.8","ts-loader":"^9.5.2","typescript":"^5.9.3","typescript-eslint":"^8.53.0","vscode-cmake-tools":"^1.3.0","vscode-nls-dev":"^4.0.4","webpack":"^5.99.7","webpack-cli":"^6.0.1"},"overrides":{"serialize-javascript":"^7.0.3","tmp":"^0.2.6"}},"location":{"$mid":1,"path":"/c:/Users/Frank/.vscode/extensions/ms-vscode.cpp-devtools-0.7.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"Microsoft","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1787731743839,"pinned":false,"source":"gallery","id":"a71e0b52-0402-498f-a148-d2e344390f14","publisherId":"5f5636e7-69ed-4afe-b5d6-8d231fb3d3ee","publisherDisplayName":"Microsoft","targetPlatform":"undefined","updated":true,"private":false,"isPreReleaseVersion":true,"hasPreReleaseVersion":true,"preRelease":true,"size":518296},"isValid":true,"validations":[],"preRelease":true,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"idleberg.nsis","uuid":"3050e4fb-2d2c-4d38-a9b6-8a6d9657d34f"},"manifest":{"name":"nsis","displayName":"NSIS","description":"Language syntax, IntelliSense and build system for Nullsoft Scriptable Install System (NSIS)","version":"5.6.9","publisher":"idleberg","license":"MIT","author":{"name":"Jan T. Sott","url":"http://github.com/idleberg"},"scripts":{"compile":"npm run build","build":"concurrently --prefix-colors 'blue,green' 'npm:build:*'","build:code":"tsdown","build:image":"sharp resize 1024 1024 --input \"node_modules/@nsis/logo/images/Logo/below 48x48/outlines-light.svg\" --output resources/logo.png","dev":"npm run start","lint":"biome check","publish:ovsx":"ovsx publish --no-dependencies","publish:vsce":"vsce publish --githubBranch main --no-dependencies --allow-package-env-file --allow-package-all-secrets","start":"npm run build -- --watch","test":"echo \"no tests yet\" && exit 0","vscode:prepublish":"npm run build"},"keywords":["nsis","wine"],"repository":{"type":"git","url":"git+https://github.com/idleberg/vscode-nsis.git"},"homepage":"https://github.com/idleberg/vscode-nsis#readme","bugs":{"url":"https://github.com/idleberg/vscode-nsis/issues"},"sponsor":{"url":"https://buymeacoffee.com/idleberg"},"type":"commonjs","main":"./lib/index.cjs","dependencies":{"@nsis/dent":"^0.16.0","@nsis/nlf":"^0.14.2","makensis":"3.0.6","micromatch":"^4.0.8","open":"^11.0.1","vscode-get-config":"^0.6.3","which":"^7.0.0"},"devDependencies":{"@commitlint/cli":"^21.2.2","@commitlint/config-conventional":"^21.2.2","@idleberg/configs":"^0.4.6","@nsis/logo":"0.1.1","@types/micromatch":"^4.0.10","@types/node":"^26.3.0","@types/vscode":"1.98.0","@types/which":"^3.0.4","concurrently":"^10.0.5","ovsx":"^1.1.1","sharp-cli":"^6.0.0","tsdown":"^0.22.14","typescript":"^6.0.3"},"activationEvents":["onStartupFinished"],"icon":"resources/logo.png","galleryBanner":{"color":"#9e90aa","theme":"dark"},"engines":{"vscode":"^1.98.0"},"categories":["Formatters","Programming Languages","Snippets","Other"],"contributes":{"configurationDefaults":{"[nsis]":{"files.encoding":"utf8bom"}},"configuration":{"type":"object","title":"NSIS","properties":{"nsis.compiler.pathToMakensis":{"type":"string","default":"makensis","markdownDescription":"Specify the full path to `makensis`.","order":1},"nsis.compiler.verbosity":{"type":"string","enum":["-1","0","1","2","3","4"],"enumDescriptions":["(not set)","none","no warnings","no info","no script","all"],"default":"3","markdownDescription":"Specify the default verbosity for `makensis`.","order":2},"nsis.compiler.strictMode":{"type":"boolean","default":false,"description":"Enabling strict mode will treat warnings as errors. Note that when disabled, running *NSIS: Compile Strict* will override the setting.","order":3},"nsis.compiler.customArguments":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Specify any of the default [compiler arguments](http://nsis.sourceforge.net/Docs/Chapter3.html#usage). Note that these will have precedence over other extension settings.","order":4},"nsis.diagnostics.enableDiagnostics":{"type":"boolean","default":true,"description":"Toggle diagnostic mode to underline warnings and errors in your code","order":5},"nsis.diagnostics.preprocessMode":{"type":"string","enum":["(none)","PPO","Safe PPO"],"default":"PPO","markdownDescription":"Linter runs in the much faster [pre-process mode](https://nsis.sourceforge.io/Docs/Chapter3.html#usagereference), but ignores warnings (unless in strict mode).","order":6},"nsis.diagnostics.overrideCompression":{"type":"boolean","default":true,"description":"Overrides compression settings to speed up diagnostics","order":7},"nsis.diagnostics.excludedFiles":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Specify files that will be excluded from diagnostics. Supports [glob patterns](https://github.com/micromatch/micromatch#matching-features).","order":8},"nsis.diagnostics.useCustomArguments":{"type":"boolean","default":false,"description":"Use custom compiler arguments in diagnostics mode. Enabling this will override the Diagnostics Custom Arguments option.","order":9},"nsis.diagnostics.customArguments":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Specify any of the default [compiler arguments](http://nsis.sourceforge.net/Docs/Chapter3.html#usage) for diagnostics mode.","order":10},"nsis.showNotifications":{"type":"boolean","default":true,"description":"Show build notifications indicating success or failure","order":11},"nsis.processHeaders":{"type":"string","enum":["Allow","Disallow","Disallow & Never Ask Me"],"enumDescriptions":["Compilation is enabled for both, .nsi and .nsh files","Compilation is enabled for .nsi files only, displays a warning when trying to compile .nsh files","Compilation is enabled for .nsi files only, no additional warnings are displayed"],"default":"Disallow","markdownDescription":"By default, only `.nsi` files will be compiled. This setting enables compilation for `.nsh` files as well.","order":12},"nsis.showOutputView":{"type":"string","enum":["Always","On Warnings & Errors","On Errors","Never"],"enumDescriptions":["The output panel is shown whenever a script is compiled","The output panel is only shown when the compiled script has warnings or errors","The output panel is only shown when the compiled script has errors","The output panel is never shown"],"default":"On Errors","markdownDescription":"Specify when to show compiler output in the output view.","order":13},"nsis.alwaysOpenBuildTask":{"type":"boolean","default":true,"description":"Specify whether to open the newly created build task","order":14},"nsis.showVersionAsInfoMessage":{"type":"boolean","default":false,"description":"Specify whether to show version as message","order":15},"nsis.showFlagsAsObject":{"type":"boolean","default":true,"description":"Specify whether to format compiler flags as JSON","order":16},"nsis.wine.runWithWine":{"type":"boolean","default":false,"markdownDescription":"Runs compiled installers using [Wine](https://www.winehq.org/).","order":17},"nsis.wine.pathToWine":{"type":"string","default":"wine","markdownDescription":"Specifies a custom path to `wine`, useful when relying on alternatives such as `wine32` or [`wine32on64`](https://github.com/Gcenx/homebrew-wine).","order":18},"nsis.muteANSIDeprecationWarning":{"type":"boolean","default":false,"description":"Toggle ANSI deprecation warning","order":19},"nsis.formatter.endOfLine":{"type":"string","enum":["(auto)","lf","crlf"],"enumDescriptions":["Uses the operating system's default end of line sequence","line-feed (LF)","carriage return + line-feed (CRLF)"],"default":"(auto)","markdownDescription":"Specify the end of line sequence used by the formatter. Defaults to the operating system's standard EOL sequence.","order":20},"nsis.formatter.commentStyle":{"type":"string","enum":["(preserve)","hash","semi"],"enumDescriptions":["Preserve existing comment style","Use hash (#) for comments","Use semi-colon (;) for comments"],"default":"(preserve)","markdownDescription":"Specify the comment style used by the formatter. Defaults to preserving the existing comment style.","order":21},"nsis.formatter.indentSize":{"type":"number","markdownDescription":"Specify the number of spaces per indentation level. When not set, the editor's tab size is used.","order":22},"nsis.formatter.printWidth":{"type":"number","default":120,"markdownDescription":"Specify the maximum line width for the formatter. Lines exceeding this width will be wrapped. Specify `0` to disable line wrapping.","order":23},"nsis.formatter.singleQuote":{"type":"boolean","default":false,"markdownDescription":"Prefer single quotes instead of double quotes.","order":24},"nsis.formatter.trimEmptyLines":{"type":"boolean","default":true,"markdownDescription":"Trim trailing whitespace from empty lines.","order":25},"nsis.formatter.useTabs":{"type":"boolean","default":true,"markdownDescription":"Use tabs for indentation instead of spaces.","order":26}}},"languages":[{"id":"makensis","aliases":["MakeNSIS Log"]},{"id":"nsis","aliases":["NSIS","nsis"],"extensions":[".nsi",".nsh",".bnsi",".bnsh"],"firstLine":"^#!/.*\\bmakensis\\b","configuration":"./config/nsis.json"},{"id":"nlf","aliases":["NSIS Language File","nlf"],"extensions":[".nlf"],"configuration":"./config/nlf.json"},{"id":"nsis-injection"}],"grammars":[{"language":"makensis","scopeName":"source.makensis","path":"./syntaxes/makensis.tmLanguage"},{"language":"nsis","scopeName":"source.nsis","path":"./syntaxes/nsis.tmLanguage"},{"language":"nlf","scopeName":"source.nlf","path":"./syntaxes/nlf.tmLanguage"},{"language":"nsis-injection","scopeName":"markdown.nsis.codeblock","path":"./syntaxes/codeblock.json","injectTo":["text.html.markdown"],"embeddedLanguages":{"meta.embedded.block.nsis":"nsis"}}],"commands":[{"command":"extension.nsis.compile","title":"NSIS: Save & Compile Script","icon":"$(run)"},{"command":"extension.nsis.compile-strict","title":"NSIS: Save & Compile Script (strict)","icon":"$(run-all)"},{"command":"extension.nsis.command-reference","title":"NSIS: Command Reference","icon":"$(book)"},{"command":"extension.nsis.show-version","title":"NSIS: Show Version"},{"command":"ext