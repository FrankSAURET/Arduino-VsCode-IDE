r-portal":{"description":"Developer portal icon in command tree view","default":{"fontPath":"./media/fonts/icons.woff","fontCharacter":"\\E001"}},"otk-m365-icon":{"description":"Microsoft 365 icon in command tree view","default":{"fontPath":"./media/fonts/icons.woff","fontCharacter":"\\E002"}}},"viewsContainers":{"activitybar":[{"id":"OfficeAddinDevKit","title":"Office Add-ins Development Kit","icon":"./media/m365icon.svg"}]},"viewsWelcome":[{"view":"office-addin-empty-project","contents":"Jump right into Office Add-ins Development Kit and get an overview of the fundamentals. For more information, visit [Get Started](command:otk.openWelcome?%5B%22SideBar%22%5D).\nWalk through the steps to build a real-world Office Add-in project.\n[Documentation](command:otk.openOfficeDevDocument?%5B%22SideBar%22%5D)\nBefore creating an add-in, please ensure [Node.js](https://nodejs.org/) and npm are installed as [prerequisites](https://learn.microsoft.com/office/dev/add-ins/develop/development-kit-overview?tabs=vscode#prerequisites).\nCreate a project or explore our samples.\n[Create a New Add-in](command:otk.create?%5B%22SideBar%22%5D)\n[View Samples](command:otk.openSamples?%5B%22SideBar%22%5D)","enablement":"otk.initialized"}],"views":{"OfficeAddinDevKit":[{"id":"office-addin-empty-project","name":"Office Add-ins Development Kit","when":"!otk.isOfficeAddIn"},{"id":"office-addin-run-and-debug","name":"RUN AND DEBUG","when":"otk.isOfficeAddIn"},{"id":"office-addin-development","name":"ADD-IN DEVELOPMENT","when":"otk.isOfficeAddIn"},{"id":"office-addin-useful-links","name":"USEFUL LINKS","when":"otk.isOfficeAddIn"}]},"menus":{"view/title":[{"command":"otk.openOfficeDevDevelopmentLink","when":"view == office-addin-development","group":"navigation@1"},{"command":"otk.openOfficeDevLifecycleLink","when":"view == office-addin-run-and-debug","group":"navigation@1"}],"commandPalette":[{"command":"otk.openOfficeDevLifecycleLink","when":"false"},{"command":"otk.openOfficeDevDevelopmentLink","when":"false"}]},"commands":[{"command":"otk.openOfficeDevLifecycleLink","title":"Get More Info About Lifecycle","icon":"$(info)"},{"command":"otk.openOfficeDevDevelopmentLink","title":"Get More Info About Development","icon":"$(info)"},{"command":"otk.create","title":"Create New Add-in","category":"Office"},{"command":"otk.openSamples","title":"View Samples","category":"Office"},{"command":"otk.openOfficeDevDocument","title":"Documentation","category":"Office"},{"command":"otk.openWelcome","title":"Get Started","category":"Office"},{"command":"otk.localdebug","title":"Preview Your Office Add-in (F5)","category":"Office","enablement":"otk.isOfficeAddIn"},{"command":"otk.stopDebugging","title":"Stop Previewing Your Office Add-in","category":"Office","enablement":"otk.isOfficeAddIn"},{"command":"otk.installDependency","title":"Check and Install Dependencies","category":"Office","enablement":"otk.isOfficeAddIn"},{"command":"otk.validateApplication","title":"Validate Manifest File","category":"Office","enablement":"otk.isOfficeAddIn"}],"taskDefinitions":[{"type":"otk","required":["command"],"properties":{"command":{"anyOf":[{"const":"otk.check-and-install-deps","description":"Check and install dependencies"}]}}}],"languages":[{"id":"office-addin-dev-kit-output"}],"grammars":[{"language":"office-addin-dev-kit-output","scopeName":"office-addin-dev-kit-output","path":"./syntaxes/office-addin-dev-kit-output.tmLanguage"}],"walkthroughs":[{"id":"officeAddinDevKitGetStarted","title":"Get Started with Office Add-ins Development Kit","description":"Jump start your Office Add-ins development experience.","steps":[{"id":"officeAddinDevKitEnvironment","title":"Get your environment ready","description":"Developing Office Add-ins with JavaScript or TypeScript requires NPM and Node.js. Check your environment to prepare for your first Office Add-in.\n[Run Prerequisite Checker](command:otk.prerequisitesCheck?%5B%22WalkThrough%22%5D)","media":{"svg":"media/walkthrough/Prerequisites.svg","altText":"Get your environment ready"}},{"id":"officeAddinDevKitBuildApp","title":"Build your first Office Add-in","description":"Get started on your first add-in.\nYou can create it from scratch or [explore our samples](command:otk.openSamples?%5B%22WalkThrough%22%5D) to help you get started with real-world examples and code structures.\n[Create a New Add-in](command:otk.create?%5B%22WalkThrough%22%5D)","media":{"svg":"media/walkthrough/Create.svg","altText":"Build your first Office Add-in"}},{"id":"officeAddinDevKitLocalPreview","title":"Preview your Office Add-in locally","description":"After creating your project in a new window, select \"Preview Your Office Add-in(F5)\" to launch the add-in and debug the code. In the Quick Pick menu, select the option \"Desktop (Edge Chromium)\".\nThe extension then checks that the prerequisites are met before debugging starts. Check the terminal for detailed information if there are issues with your environment. After this process, the Office desktop application launches and sideloads the add-in.","media":{"svg":"media/walkthrough/PreviewLocally.svg","altText":"Preview your Office Add-in locally"}},{"id":"officeAddinDevKitExploreMore","title":"What's next?","description":"Here are some recommendations to continue your journey with Office Add-ins Development Kit.\n • [Explore our samples](command:otk.openSamples?%5B%22WalkThrough%22%5D) for real-world examples and code structures.\n • Read our [documentation](command:otk.openOfficeDevDocument?%5B%22WalkThrough%22%5D) on Office Add-ins.","media":{"svg":"media/walkthrough/whatsnext.svg","altText":"How-to guides, README.md and Documentation"}}]}]},"scripts":{"build":"pnpm run build:dev","build:dev":"pnpm run clean && pnpm run webpack:dev","build:prod":"pnpm run clean && pnpm run webpack:prod","bundle":"pnpm run build:prod && vsce package --no-dependencies","watch":"pnpm run clean && pnpm run webpack:watch","webpack:watch":"webpack --watch","webpack:dev":"webpack","webpack:prod"