8","globals":"^16.5.0","ts-loader":"^9.5.4","tslib":"^2.8.1","typescript":"^5.9.3","typescript-eslint":"^8.48.1","webpack":"^5.103.0","webpack-cli":"^6.0.1"},"dependencies":{"@vscode/python-extension":"^1.0.6","adm-zip":"^0.5.16","got":"^14.6.5","ini":"^6.0.0","toml":"^3.0.0","undici":"^7.16.0","which":"^5.0.0","yaml":"^2.8.2"},"packageManager":"npm@11.6.4+sha512.1118cab46a05a50aee6bff5b1b4fa1df18afff89d57465620a3518035026955db87c5bdf9d207b07b7487d99f2490d450cb774655ad63ec2cba7bf1d0ad25d45"},"location":{"$mid":1,"path":"/c:/Users/Frank/.vscode/extensions/raspberry-pi.raspberry-pi-pico-0.22.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"Raspberry Pi","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1788241247330,"pinned":false,"source":"gallery","id":"38fd19eb-86e9-4f0b-a7ee-d61406931ba9","publisherId":"0c68ffdb-3056-4f56-a583-8680ee1f2cd3","publisherDisplayName":"Raspberry Pi","targetPlatform":"undefined","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":true,"preRelease":true,"size":37568090},"isValid":true,"validations":[],"preRelease":true,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"pucelle.run-on-save","uuid":"f23b142c-d9c8-4bce-b791-57315e8cf4f3"},"manifest":{"name":"run-on-save","displayName":"Run on Save","description":"Run configured shell commands when a file is saved in vscode, and output configured messages on status bar.","icon":"images/logo.png","version":"1.12.0","license":"MIT","publisher":"pucelle","homepage":"https://github.com/pucelle/vscode-run-on-save","repository":{"type":"git","url":"https://github.com/pucelle/vscode-run-on-save"},"bugs":{"url":"https://github.com/pucelle/vscode-run-on-save/issues"},"engines":{"vscode":"^1.93.0"},"categories":["Other"],"keywords":["run on save","save and run","compile scss on save","compile less on save","compile files on save"],"activationEvents":["onStartupFinished"],"main":"./out/extension.js","contributes":{"commands":[{"command":"extension.enableRunOnSave","title":"Run On Save: Enable"},{"command":"extension.disableRunOnSave","title":"Run On Save: Disable"}],"configuration":{"title":"Run On Save","type":"object","properties":{"runOnSave.statusMessageTimeout":{"type":"number","description":"Specify the timeout in millisecond after which the status message will be hidden. Works when `runIn=backend`, can be overwritten by the `statusMessageTimeout` in each command.","default":3000},"runOnSave.ignoreFilesBy":{"type":"array","items":{"type":"string","enum":[".gitignore",".npmignore"]},"default":[],"description":"Specifies it to ignore files list in `.gitignore` or `.npmignore`."},"runOnSave.shell":{"type":"string","description":"Specify what shell will be used for all the commands. Default is vscode's default shell.","default":null},"runOnSave.defaultRunIn":{"type":"string","description":"Run command in which environment by default. Default value is `backend`.","enum":["backend","terminal","vscode"],"default":"backend","enumDescriptions":["Run command silently and output messages to output channel, you can specify `runningStatusMessage` and `finishStatusMessage` to give you feedback. Choose this when you don't want to be disturbed.","Run command in vscode terminal, which keeps message colors. Choose this when you want to get command feedback details.","Run vscode's command. Choose this if you want to execute vscode's own command or a command from a installed vscode extension."]},"runOnSave.onlyRunOnManualSave":{"type":"boolean","description":"Only run commands when manually saving a file. Default value is `false`.","default":false},"runOnSave.commands":{"type":"array","description":"Shell commands array.","default":[],"items":{"type":"object","properties":{"languages":{"type":"array","description":"Specify an array of languageIds for which this command applies to.","default":[],"uniqueItems":true,"items":{"type":"string","examples":["abap","bat","bibtex","clojure","coffeescript","c","cpp","csharp","dockercompose","css","cuda-cpp","d","dart","pascal","diff","dockerfile","erlang","fsharp","git-rebase","go","groovy","handlebars","haml","haskell","html","ini","java","javascript","javascriptreact","json","jsonc","julia","latex","less","lua","makefile","markdown","objective-c","objective-cpp","ocaml","pascal","perl6","php","plaintext","powershell","pug","python","r","razor","ruby","rust","syntax)","shaderlab","shellscript","slim","sql","stylus","svelte","swift","typescript","typescriptreact","tex","vb","vue","vue-html","xml","xsl","yaml"]}},"match":{"type":"string","description":"Specify a RegExp source to match file path. Note if specifies both `match` and `globMatch`, commands matched them both will be executed.","default":""},"notMatch":{"type":"string","description":"Specify a RegExp source, the files whole path match it will be excluded.","default":""},"globMatch":{"type":"string","description":"Specify a glob expression to match file path. reference to: https://github.com/isaacs/node-glob#glob-primer. Note if specifies both `match` and `globMatch`, only commands matched them both will be executed.","default":""},"doNotDisturb":{"type":"boolean","description":"Prevent the output from taking focus. For terminal visibility, prefer `terminalReveal`. Only works when `runIn=backend` or `runIn=terminal`.","default":false},"globMatchOptions":{"type":"object","description":"Options for glob match, see: https://github.com/isaacs/minimatch?tab=readme-ov-file#options","additionalProperties":false,"properties":{"allowWindowsEscape":{"type":"boolean"},"debug":{"type":"boolean"},"dot":{"type":"boolean"},"flipNegate":{"type":"boolean"},"magicalBraces":{"type":"boolean"},"matchBase":{"type":"boolean"},"nobrace":{"type":"boolean"},"nocase":{"type":"boolean"},"nocaseMagicOnly":{"type":"boolean"},"nocomment":{"type":"boolean"},"noext":{"type":"boolean"},"noglobstar":{"type":"boolean"},"nonegate":{"type":"boolean"},"nonull":{"type":"boolean"},"optimizationLevel":{"type":"number"},"partial":{"type":"boolean"},"platform":{"enum":["aix","android","darwin","freebsd","haiku","linux","openbsd","sunos","win32","cygwin","netbsd"],"type":"string"},"preserveMultipleSlashes":{"type":"boolean"},"windowsNoMagicRoot":{"type":"boolean"},"windowsPathsNoEscape":{"type":"boolean"}}},"commandBeforeSaving":{"type":"string","description":"Specify the command to be executed before saving the file. Note that for backend command, file will be saved after command executed completed.","default":"echo ${file}"},"command":{"type":"string","description":"Specify the command to be executed after file saved.","default":"echo ${file}"},"args":{"type":["string","array","object"],"description":"Specify the command parameters, can be a string, array of string, or an object. Note for a `backend` or `terminal` command, if args option is defined as array of string, or an object, will format argument to add quotes if needed. e.g., `['-a', 'Value 1']` will be formatted as `-a \"Value 1\"`","default":""},"runIn":{"type":"string","description":"Run command in which environment, if not specified, uses `runOnSave.defaultRunIn`.","enum":["backend","terminal","vscode"],"default":"backend","enumDescriptions":["Run command silently and output messages to output channel, you can specify `runningStatusMessage` and `finishStatusMessage` to give you feedback. Choose this when you don't want to be disturbed.","Run command in vscode terminal, which keeps message colors. Choose this when you want to get command feedback details.","Run vscode's command. Choose this if you want to execute vscode's own command or a command from a installed vscode extension."]},"async":{"type":"boolean","description":"All the commands with `async: false` will run in a sequence, means run next after previous completed. Default value is `true`.","default":true},"commandDebounce":{"type":"number","description":"Wait this many milliseconds after the latest matching save before running the command. Additional saves reset the timer, and the final command uses variables from the latest saved file. Default is `0` (disabled).","minimum":0,"default":0},"runningStatusMessage":{"type":"string","description":"Specify the status bar message when the shell command began to run. Only works when `runIn=backend`.","default":""},"finishStatusMessage":{"type":"string","description":"Specify the status bar message after the shell command finished executing. Only works when `runIn=backend`.","default":""},"statusMessageTimeout":{"type":"number","description":"Specify the timeout in millisecond after which the status message will hide. Only works when `runIn=backend`.","default":3000},"terminalHideTimeout":{"type":"number","description":"Specify the timeout in millisecond after which the terminal for running current command will hide. Only works when `runIn=terminal`. If default value is `-1`, set it as a value `>=0` can make it work.","default":-1},"terminalReveal":{"type":"string","description":"Control when the terminal is revealed. `onError` requires VS Code terminal shell integration and falls back to `always` when unavailable. Only works when `runIn=terminal`. For terminal command ignores `doNotDisturb` after setting this option","enum":["always","onError","never"],"default":"always"},"workingDirectoryAsCWD":{"type":"boolean","description":"Specify the vscode working directory as shell CWD (Current Working Directory). Only works when `runIn=backend`.","default":true},"clearOutput":{"type":"boolean","description":"Clear the output channel before running. Default value is `false`.","default":false}}}},"runOnSave.commandsBeforeSaving":{"type":"array","description":"Shell commands array, just like `runOnSave.commands`, but runs before saving documents.","default":[],"items":{"type":"object","properties":{"languages":{"type":"array","description":"Specify an array of language ids for which this command applies to.","default":[],"uniqueItems":true,"items":{"type":"string","examples":["abap","bat","bibtex","clojure","coffeescript","c","cpp","csharp","dockercompose","css","cuda-cpp","d","dart","pascal","diff","dockerfile","erlang","fsharp","git-rebase","go","groovy","handlebars","haml","haskell","html","ini","java","javascript","javascriptreact","json","jsonc","julia","latex","less","lua","makefile","markdown","objective-c","objective-cpp","ocaml","pascal","perl6","php","plaintext","powershell","pug","python","r","razor","ruby","rust","syntax","shaderlab","shellscript","slim","sql","stylus","svelte","swift","typescript","typescriptreact","tex","vb","vue","vue-html","xml","xsl","yaml"]}},"match":{"type":"string","description":"Specify a RegExp source to match file path. Note if specifies both `match` and `globMatch`, commands matched them both will be executed.","default":""},"notMatch":{"type":"string","description":"Specify a RegExp source, the files whole path match it will be excluded.","default":""},"globMatch":{"type":"string","description":"Specify a glob expression to match file path. reference to: https://github.com/isaacs/node-glob#glob-primer. Note if specifies both `match` and `globMatch`, only commands matched them both will be executed.","default":""},"globMatchOptions":{"type":"object","description":"Options for glob match, see: https://github.com/isaacs/minimatch?tab=readme-ov-file#options","additionalProperties":false,"properties":{"allowWindowsEscape":{"type":"boolean"},"debug":{"type":"boolean"},"dot":{"type":"boolean"},"flipNegate":{"type":"boolean"},"magicalBraces":{"type":"boolean"},"matchBase":{"type":"boolean"},"nobrace":{"type":"boolean"},"nocase":{"type":"boolean"},"nocaseMagicOnly":{"type":"boolean"},"nocomment":{"type":"boolean"},"noext":{"type":"boolean"},"noglobstar":{"type":"boolean"},"nonegate":{"type":"boolean"},"nonull":{"type":"boolean"},"optimizationLevel":{"type":"number"},"partial":{"type":"boolean"},"platform":{"enum":["aix","android","darwin","freebsd","haiku","linux","openbsd","sunos","win32","cygwin","netbsd"],"type":"string"},"preserveMultipleSlashes":{"type":"boolean"},"windowsNoMagicRoot":{"type":"boolean"},"windowsPathsNoEscape":{"type":"boolean"}}},"commandBeforeSaving":{"type":"string","description":"Specify the command to be executed before saving the file. Note that for backend command, file will be saved after command executed completed.","default":"echo ${file}"},"command":{"type":"string","description":"Specify the command to be executed after file saved.","default":"echo ${file}"},"args":{"type":["string","array","object"],"description":"Specify the command parameters, can be a string, array of string, or an object. Note for a `backend` or `terminal` command, if args option is defined as array of string, or an object, will format argument to add quotes if needed. e.g., `['-a', 'Value 1']` will be formatted as `-a \"Value 1\"`","default":""},"runIn":{"type":"string","description":"Run command in.","enum":["backend","terminal","vscode"],"default":"backend","enumDescriptions":["Run command silently and output messages to output channel, you can specify `runningStatusMessage` and `finishStatusMessage` to give you feedback. Choose this when you don't want to be disturbed.","Run command in vscode terminal, which keeps message colors. Choose this when you want to get command feedback details.","Run vscode's command. Choose this if you want to execute vscode's own command or a command from a installed vscode extension."]},"async":{"type":"boolean","description":"All the commands with `async: false` will run in a sequence, means run next after previous completed. Default value is `true`.","default":true},"commandDebounce":{"type":"number","description":"Wait this many milliseconds after the latest matching save before running the command. Additional saves reset the timer, and the final command uses variables from the latest saved file. Default is `0` (disabled).","minimum":0,"default":0},"runningStatusMessage":{"type":"string","description":"Specify the status bar message when the shell command began to run. Only works when `runIn=backend`.","default":""},"finishStatusMessage":{"type":"string","description":"Specify the status bar message after the shell command finished executing. Only works when `runIn=backend`.","default":""},"statusMessageTimeout":{"type":"number","description":"Specify the timeout in millisecond after which the status message will hide. Only works when `runIn=backend`.","default":3000},"terminalHideTimeout":{"type":"number","description":"Specify the timeout in millisecond after which the terminal for running current command will hide. Only works when `runIn=terminal`. If default value is `-1`, set it as a value `>=0` can make it work.","default":-1},"terminalReveal":{"type":"string","description":"Control when the terminal is revealed. `onError` requires VS Code terminal shell integration and falls back to `always` when unavailable. Only works when `runIn=terminal`.","enum":["always","onError","never"],"default":"always"},"workingDirectoryAsCWD":{"type":"boolean","description":"Specify the vscode working directory as shell CWD (Current Working Directory). Only works when `runIn=backend`.","default":true},"clearOutput":{"type":"boolean","description":"Clear the output channel before running. Default value is `false`.","default":false},"doNotDisturb":{"type":"boolean","description":"Prevent the output from taking focus. For terminal visibility, prefer `terminalReveal` detailed control. Only works when `runIn=backend` or `runIn=terminal`.","default":false}}}}}}},"scripts":{"vscode:prepublish":"npm run build","package":"vsce package","publish":"vsce publish","build":"tsc -p ./","watch":"tsc -watch -p ./","test":"cd test && tsc -b && vscode-test"},"devDependencies":{"@types/fs-extra":"^11.0.1","@types/mocha":"^2.2.48","@types/node":"^20.5.4","@types/vscode":"^1.93.0","@vscode/test-cli":"0.0.4","@vscode/test-electron":"^2.3.8","typescript":"^4.9.5"},"dependencies":{"fs-extra":"^11.1.1","minimatch":"^10.0.3"}},"location":{"$mid":1,"path":"/c:/Users/Frank/.vscode/extensions/pucelle.run-on-save-1.12.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"pucelle","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1788412674158,"pinned":false,"source":"gallery","id":"f23b142c-d9c8-4bce-b791-57315e8cf4f3","publisherId":"7650fded-a9d9-4383-a346-4136ebe47608","publisherDisplayName":"pucelle","targetPlatform":"undefined","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":324643},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"electropol-fr.kablix","uuid":"eebcb537-90a4-4c3d-9bf7-e50f7fc9ef9b"},"manifest":{"name":"kablix","displayName":"Kablix","version":"2026.9.1","buildNumber":47,"description":"A microcontroller simulator (Arduino Uno / Raspberry Pi Pico) right inside VS Code, 100% offline.","publisher":"electropol-fr","author":{"name":"electropol.fr","url":"https://electropol.fr"},"license":"MIT","icon":"media/icon.png","repository":{"type":"git","url":"https://github.com/FrankSAURET/kablix"},"bugs":{"url":"https://github.com/FrankSAURET/kablix/issues"},"homepage":"https://github.com/FrankSAURET/kablix#readme","engines":{"vscode":"^1.85.0"},"categories":["Education","Visualization","Other"],"keywords":["arduino","raspberry pi pico","microcontroller","simulator","simulation","rp2040","rp2350","avr","offline"],"main":"./dist/extension.js","activationEvents":[],"contributes":{"commands":[{"command":"kablix.openSimulator","title":"Kablix: Open the simulator","category":"Kablix"},{"command":"kablix.compileAndRun","title":"Kablix: Compile","category":"Kablix"},{"command":"kablix.loadWorkspaceArtifact","title":"Kablix: Load the compiled artifact of the workspace","category":"Kablix"},{"command":"kablix.saveProject","title":"Kablix: Save project (.projix)","category":"Kablix"},{"command":"kablix.saveProjectSmart","title":"Kablix: Save project (smart name)","category":"Kablix"},{"command":"kablix.openProject","title":"Kablix: Open project (.projix)","category":"Kablix"},{"command":"kablix.exportWokwiDiagram","title":"Kablix: Export the Wokwi diagram (diagram.json)","category":"Kablix"},{"command":"kablix.importWokwiDiagram","title":"Kablix: Import a Wokwi diagram (diagram.json)","category":"Kablix"},{"command":"kablix.exportPartsCsv","title":"Kablix: Export the part list (CSV)","category":"Kablix"},{"command":"kablix.checkLibraryUpdates","title":"Kablix: Check for library updates","category":"Kablix"},{"command":"kablix.upgradePicoFirmware","title":"Kablix: Upgrade Pico firmware","category":"Kablix"},{"command":"kablix.openHelp","title":"Kablix: Help","category":"Kablix"},{"command":"kablix.saveDefaultLayout","title":"Kablix: Save the default layout","category":"Kablix"},{"command":"kablix.rearrangeLayout","title":"Kablix: Rearrange the windows","category":"Kablix"},{"command":"kablix.associateProjix","title":"Kablix: Associate .projix files with Kablix","category":"Kablix"},{"command":"kablix.fixIntelliSense","title":"Kablix: Fix code analysis for this board","category":"Kablix"},{"command":"kablix.recommendedExtensions","title":"Kablix: Recommended extensions","category":"Kablix"},{"command":"kablix.chooseSvgEditor","title":"Kablix: Choose the SVG editor…","category":"Kablix"},{"command":"kablix.openComponentsFolder","title":"Kablix: Open the components library","category":"Kablix"},{"command":"kablix.openComponentManager","title":"Kablix: Manage components","category":"Kablix"},{"command":"kablix.uploadToPico","title":"Kablix: Send the program to the Pico board","category":"Kablix","icon":"media/upload.svg"},{"command":"kablix.uploadToPicoOffline","title":"Kablix: Send the program to the Pico board (no board detected)","category":"Kablix","icon":"media/upload-inactive.svg"}],"keybindings":[{"command":"kablix.saveProjectSmart","key":"ctrl+s","mac":"cmd+s","when":"activeCustomEditorId == 'kablix.projix'"}],"menus":{"editor/title":[{"command":"kablix.uploadToPico","group":"navigation@-3","when":"resourceLangId == python && kablix.picoConnected"},{"command":"kablix.uploadToPicoOffline","group":"navigation@-3","when":"resourceLangId == python && !kablix.picoConnected"}],"commandPalette":[{"command":"kablix.uploadToPicoOffline","when":"false"}]},"viewsContainers":{"activitybar":[{"id":"kablix","title":"Kablix","icon":"media/activity-icon.png"}]},"views":{"kablix":[{"id":"kablix.home","name":"Simulator"}]},"viewsWelcome":[{"view":"kablix.home","contents":"[▶ Open the simulator](command:kablix.openSimulator)"}],"customEditors":[{"viewType":"kablix.projix","displayName":"Kablix simulator","selector":[{"filenamePattern":"*.projix"}],"priority":"default"}],"configuration":{"title":"Kablix","properties":{"kablix.micropythonUf2":{"type":"string","default":"","description":"Path (absolute or workspace-relative) of the MicroPython .uf2 firmware used to run .py files on the simulated Pico. Leave empty: Kablix auto-detects a firmware in the workspace, and otherwise offers to download the official firmware on first run."},"kablix.checkUpdatesOnStartup":{"type":"boolean","default":false,"description":"Check the npm registry once at startup for newer versions of the bundled simulation libraries. Off by default (Kablix is offline by default); when on, a notification only appears if an update exists. You can also run the check manually with the \"Kablix: Check for library updates\" command."},"kablix.simulationWorker":{"type":"boolean","default":true,"description":"Run the simulation engine (Arduino and Pico alike) in a background thread, so panning, zooming and editing stay smooth while a program runs, and so a heavy page never makes the simulated clock fall behind. On by default: pin readings then come from a snapshot refreshed every 4 ms instead of the engine itself, which is invisible on screen. Turn it off to keep the engine on the main thread — Kablix also falls back there on its own if the background thread cannot start."},"kablix.checkFirmwareUpdatesOnStartup":{"type":"boolean","default":false,"description":"Check once at startup whether the cached MicroPython firmware (.uf2) for the simulated Pico matches the version bundled with this Kablix release, and offer to upgrade it if not. Off by default; when on, a notification only appears if an upgrade is available. You can also run the upgrade manually with the \"Kablix: Upgrade Pico firmware\" command."},"kablix.restoreLastProjectOnStartup":{"type":"boolean","default":true,"description":"Reopen the last Kablix project (.projix) that was open when VS Code closed, in the simulator, on startup. On by default. Other text tabs (including the associated code file) are restored natively by VS Code."},"kablix.arduinoCliPath":{"type":"string","default":"","description":"Full path to the arduino-cli executable (or the folder containing it). Set this if Kablix reports arduino-cli as missing even though it is installed (e.g. it is not on the PATH seen by VS Code). Leave empty to auto-detect via the PATH and common install locations."},"kablix.toolchainPath":{"type":"string","default":"","description":"Extra folder searched for the compilation tools (arduino-cli, avr-gcc, arm-none-eabi-gcc, objcopy, objdump). Useful for a portable toolchain that is not on the PATH. Leave empty to use the PATH only."},"kablix.showLoadBinaryButton":{"type":"boolean","default":false,"description":"Show the \"Load binary\" button in the simulator toolbar (loads an already-compiled .hex/.uf2 from the workspace without recompiling). Hidden by default."},"kablix.showResetPartsButton":{"type":"boolean","default":false,"description":"Show the \"Reset all components\" button (⟲) in the canvas toolbar: it puts every part back to its idle state (switches released, sliders at rest) without touching the wiring. Hidden by default."},"kablix.showClearDiagramButton":{"type":"boolean","default":false,"description":"Show the \"Clear the diagram\" button (eraser) in the canvas toolbar: it removes every part and wire at once (Ctrl+Z undoes it). Hidden by default."},"kablix.picowNetworkBridge":{"type":"boolean","default":true,"description":"Pico W: let MicroPython scripts make REAL HTTP requests (network/urequests) tunneled through the host (the Wi-Fi chip is not emulated). The host performs the actual fetch and returns the response to the script. On by default; turn off to block all outbound requests from simulated scripts."},"kablix.selectionColor":{"type":"string","default":"#e973e9","pattern":"^#[0-9a-fA-F]{6}$","description":"Selection color (parts, wires, bends). Any #rrggbb hex color. Kept vivid by default so it stays visible on all themes."},"kablix.svgEditorPath":{"type":"string","default":"","description":"Full path of the SVG editor (Inkscape, Illustrator…) used by \"Open in the SVG editor\" in the part creator. Empty: Kablix looks up the application your system associates with .svg files, writes it here, and asks you nothing. It only opens the picker when it finds no editor at all."},"kablix.syncArduinoIdeBoard":{"type":"boolean","default":true,"description":"Selecting an Arduino board in Kablix also selects it in the \"Arduino VS Code IDE\" extension, so your .ino sketch is recognized (IntelliSense, compilation, upload) without picking the board twice. Writes the board into .vscode/arduino.yaml, and only when that file or an .ino sketch already exists in the folder. Pico boards never touch it. On by default."},"kablix.syncIntelliSense":{"type":"boolean","default":true,"description":"Keeps code analysis valid for the board picked in Kablix, so nothing is underlined for the wrong reason. On an .ino sketch, asks \"Arduino VS Code IDE\" to rebuild its IntelliSense configuration for that board (Serial, pinMode... stop being unknown). On a Pico program, points Pylance at the MicroPython declarations shipped with the MicroPico extension, in the workspace folder settings (machine, neopixel, rp2... stop being unresolved imports). Only adds what is missing, never overwrites your own settings, and does nothing when the matching extension is not installed. On by default."},"kablix.showArduinoOutput":{"type":"boolean","default":false,"description":"Shows the Arduino output panel while Kablix sets up code analysis for an .ino sketch. Off by default: picking a board is not a build, so the panel that the \"Arduino VS Code IDE\" extension opens on every compilation is closed again right away, and once more when it re-analyses on its own a few seconds later. The Verify and Upload buttons are never touched: their output shows as usual. Turn it on to watch what the Arduino extension is doing."},"kablix.componentsFolder":{"type":"string","default":"","markdownDescription":"Folder where your custom components (.kompix) are stored. Shared by all Kablix projects on this machine. Change it if you prefer a custom location.\n\nEmpty (default): a subfolder of VS Code's global storage —\n- Windows: `%APPDATA%\\Code\\User\\globalStorage\\electropol-fr.kablix\\kablix_components`\n- macOS: `~/Library/Application Support/Code/User/globalStorage/electropol-fr.kablix/kablix_components`\n- Linux: `~/.config/Code/User/globalStorage/electropol-fr.kablix/kablix_components`\n\nThe command **Kablix: Open the components library** opens the folder currently in use, wherever it is."},"kablix.componentRepositories":{"type":"array","items":{"type":"string"},"default":["https://raw.githubusercontent.com/FrankSAURET/kablix/main/kablix_components/"],"description":"List of remote repositories (URLs) where .kompix components can be downloaded from. By default, points to the official Kablix library on GitHub."}}}},"scripts":{"vscode:prepublish":"npm run build","postinstall":"patch-package","build":"node esbuild.js --production","watch":"node esbuild.js --watch","build:firmware":"node scripts/build-firmware.mjs","build:parts":"node scripts/build-parts.mjs","build:testplan":"node scripts/make-test-plan.mjs","profil":"node scripts/_extract-profils.mjs","assemblage":"node scripts/_extract-assemblage.mjs","montre":"node scripts/montre.mjs","typecheck":"tsc --noEmit","verify":"node scripts/verify-sim.mjs","verify:compiler":"node scripts/verify-compiler.mjs","verify:diagram":"node scripts/verify-diagram.mjs","verify:uf2":"node scripts/verify-uf2.mjs","verify:firmware":"node scripts/verify-firmware.mjs","verify:updates":"node scripts/verify-updates.mjs","verify:decode":"node scripts/verify-decode.mjs","verify:micropython":"node scripts/verify-micropython.mjs","verify:wokwi":"node scripts/verify-wokwi.mjs","verify:net":"node scripts/verify-net.mjs","verify:equipot":"node scripts/verify-equipot.mjs","verify:i2c":"node scripts/verify-i2c.mjs","verify:components":"node scripts/verify-components.mjs","verify:spi":"node scripts/verify-spi-dma-unit.mjs && node scripts/verify-spi.mjs","verify:neopixel":"node scripts/verify-neopixel.mjs","verify:ledring":"node scripts/verify-ledring.mjs","verify:creator":"node scripts/verify-creator.mjs","verify:debug":"node scripts/verify-debug-py.mjs","verify:debugavr":"node scripts/verify-debug-avr.mjs","verify:arduinoide":"node scripts/verify-arduinoide.mjs","verify:intellisense":"node scripts/verify-intellisense.mjs","verify:kompix":"node scripts/verify-kompix.mjs","verify:opendrain":"node scripts/verify-opendrain.mjs","verify:libpalette":"node scripts/verify-lib-palette.mjs","verify:kompixhelp":"node scripts/verify-kompix-help.mjs","verify:projixparts":"node scripts/verify-projix-parts.mjs","verify:picoupload":"node scripts/verify-picoupload.mjs","verify:pico2":"node scripts/verify-pico2.mjs --target=rp2040 && node scripts/verify-pico2.mjs --target=rp2350","verify:all":"node scripts/verify-tous.mjs","verify:all:serie":"npm run verify && npm run verify:compiler && npm run verify:diagram && npm run verify:uf2 && npm run verif