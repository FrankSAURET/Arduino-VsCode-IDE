opol-fr.drawio-diagrams-editor","displayName":"Draw.io (Binary)","selector":[{"filenamePattern":"*.drawio.png"},{"filenamePattern":"*.dio.png"}],"priority":"default"},{"viewType":"electropol-fr.drawio-diagrams-editor-text","displayName":"Draw.io","selector":[{"filenamePattern":"*.drawio"},{"filenamePattern":"*.dio"},{"filenamePattern":"*.dio.svg"},{"filenamePattern":"*.drawio.svg"}],"priority":"default"}],"commands":[{"command":"electropol-fr.drawio-diagrams-editor.convert","title":"Convert To...","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.export","title":"Export To...","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.toggleCodeLinkActivation","title":"Toggle Code Link Activation","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.changeTheme","title":"Change Theme","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.editDiagramAsText","title":"Edit Diagram As Text (Experimental)","enablement":"electropol-fr.drawio-diagrams-editor.experimentalFeaturesEnabled","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.linkCodeWithSelectedNode","title":"Link Code with Selected Node","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.newDiagram","title":"New Draw.io Diagram","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.openDiagram","title":"Open Draw.io Diagram","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.linkFileWithSelectedNode","title":"Link File With Selected Node","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.linkSymbolWithSelectedNode","title":"Link Symbol With Selected Node","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.linkWsSymbolWithSelectedNode","title":"Link Workspace Symbol With Selected Node","category":"Draw.io"},{"command":"electropol-fr.drawio-diagrams-editor.openAsText","title":"Open Source Code Beside","category":"Draw.io","icon":"$(go-to-file)"},{"command":"electropol-fr.drawio-diagrams-editor.openAsDiagram","title":"Open Diagram Beside","category":"Draw.io","icon":"$(preview)"},{"command":"electropol-fr.drawio-diagrams-editor.associateFileType","title":"Associate .drawio Files With VS Code (Windows)","category":"Draw.io"}],"keybindings":[{"command":"electropol-fr.drawio-diagrams-editor.linkCodeWithSelectedNode","key":"shift+F3","when":"!findWidgetVisible"}],"configuration":[{"title":"General","order":10,"properties":{"electropol-fr.drawio-diagrams-editor.offline":{"type":"boolean","default":true,"title":"Use Offline Mode","description":"When enabled, the bundled instance of Draw.io is used.","order":10},"electropol-fr.drawio-diagrams-editor.online-url":{"type":"string","default":"https://embed.diagrams.net/","title":"Online URL","description":"The app to use when offline mode is disabled.","order":11},"electropol-fr.drawio-diagrams-editor.codeLinkActivated":{"type":"boolean","default":false,"title":"Code Link Enabled","description":"When activated, selecting a node will navigate to an associated code section.","order":20},"electropol-fr.drawio-diagrams-editor.local-storage":{"anyOf":[{"type":"object"},{"type":"string"}],"default":{},"readOnly":true,"title":"Draw.io Local Storage","description":"Only change this property if you know what you are doing. Manual changes to this property are not supported!","order":30},"electropol-fr.drawio-diagrams-editor.simpleLabels":{"type":"boolean","default":false,"title":"Use SimpleLabels","description":"When enabled, no ForeignObjects are used in the svg.","order":40},"electropol-fr.drawio-diagrams-editor.zoomFactor":{"type":"number","default":1.2,"title":"Draw.io zoom factor","description":"Defines the zoom factor for mouse wheel and trackpad zoom.","order":50},"electropol-fr.drawio-diagrams-editor.globalVars":{"type":"object","title":"Draw.io global variables.","description":"Defines global variables for system-wide placeholders using a JSON structure with key, value pairs. Keep the number of global variables small.","order":60},"electropol-fr.drawio-diagrams-editor.resizeImages":{"type":["boolean","null"],"title":"Draw.io resize images.","description":"If set to true, images are resized automatically on paste. If not defined, the user will be asked to confirm the resize.","default":null,"order":70},"electropol-fr.drawio-diagrams-editor.enableExperimentalFeatures":{"type":"boolean","default":false,"title":"Enable Experimental Features","description":"When enabled, experimental features such as 'Edit Diagram As Text' become available.","order":80}}},{"title":"Plugins","order":20,"properties":{"electropol-fr.drawio-diagrams-editor.plugins":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"file":{"type":"string","description":"The file path to the library. Must be absolute. You can use `${workspaceFolder}`."}}}]},"default":[],"title":"Plugins","markdownDescription":"Loads Draw.io plugins from the local filesystem. See description of the `file` property. See [plugins documentation](https://github.com/hediet/vscode-drawio/blob/master/docs/plugins.md).","order":10},"electropol-fr.drawio-diagrams-editor.knownPlugins":{"type":"array","items":{"type":"object","properties":{"pluginId":{"type":"string"},"fingerprint":{"type":"string"},"allowed":{"type":"boolean"}}},"default":[],"title":"Known Plugins","markdownDescription":"List of allowed or denied plugins. The extension will read and write to this list based on what the user decides when loading specific plugins. See [plugins documentation](https://github.com/hediet/vscode-drawio/blob/master/docs/plugins.md).","scope":"application","order":15},"electropol-fr.drawio-diagrams-editor.customLibraries":{"type":"array","items":{"type":"object","properties":{"entryId":{"type":"string","description":"The id of the entry."},"libName":{"type":"string","description":"The name of the library."}},"anyOf":[{"type":"object","properties":{"url":{"type":"string"}}},{"type":"object","properties":{"xml":{"type":"string"}}},{"type":"object","properties":{"json":{}}},{"type":"object","properties":{"file":{"type":"string","description":"The file path to the library. Must be absolute. You can use ${workspaceFolder}."}}}]},"default":[],"title":"Custom Libraries","description":"Configures the Draw.io editor to use custom libraries.","order":50},"electropol-fr.drawio-diagrams-editor.libraryFolders":{"type":"array","items":{"type":"string"},"default":[],"title":"Library Folders","markdownDescription":"Folders scanned recursively for shape libraries (`.xml` files containing `<mxlibrary>`). Every library found is listed in the **More Shapes** dialog under its file name followed by a star, grouped into one category per folder, and can be switched on or off there like any other shape set. Paths must be absolute; `${workspaceFolder}` is supported.","order":55}}},{"title":"Theme and styles","order":30,"properties":{"electropol-fr.drawio-diagrams-editor.styles":{"title":"Styles","description":"Defines an array of objects that contain the colours (fontColor, fillColor, strokeColor and gradientColor) for the Style tab of the format panel if the selection is empty.","type":"array","items":{"type":"object","properties":{"commonStyle":{"type":"object","properties":{"fontColor":{"type":"string"},"strokeColor":{"type":"string"},"fillColor":{"type":"string"}}},"graph":{"type":"object","properties":{"background":{"type":"string"},"gridColor":{"type":"string"}}}}}},"electropol-fr.drawio-diagrams-editor.defaultVertexStyle":{"title":"Default Vertex Style","description":"Default styling of vertices (shapes).","type":"object"},"electropol-fr.drawio-diagrams-editor.defaultEdgeStyle":{"title":"Default Edge Style","description":"Default styling of edges.","type":"object"},"electropol-fr.drawio-diagrams-editor.colorNames":{"title":"Color Names","description":"Names for colors, eg. {'FFFFFF': 'White', '000000': 'Black'} that are used as tooltips (uppercase, no leading # for the colour codes)","type":"object"},"electropol-fr.drawio-diagrams-editor.presetColors":{"title":"Preset Colors","description":"Color codes for the upper palette in the color dialog.","type":"array","items":{"type":"string"}},"electropol-fr.drawio-diagrams-editor.customColorSchemes":{"title":"Custom Color Schemes","markdownDescription":"Available color schemes in the style section at the top of the format panel.","type":"array","items":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"fill":{"type":"string"},"stroke":{"type":"string"},"gradient":{"type":"string"},"font":{"type":"string"}}}}},"electropol-fr.drawio-diagrams-editor.customFonts":{"type":"array","items":{"type":"string"},"default":[],"title":"Custom Fonts","description":"Configures the Draw.io editor to use custom fonts."},"electropol-fr.drawio-diagrams-editor.theme":{"title":"Draw.io Theme","type":"string","default":"kennedy","enum":["kennedy","min"],"description":"The theme to use for the Draw.io editor. Use \"automatic\" to automatically choose a Draw.io theme that matches your current VS Code theme."},"electropol-fr.drawio-diagrams-editor.appearance":{"title":"Draw.io Appearance","type":"string","default":"light","enum":["automatic","light","dark","high-contrast-light","high-contrast"],"description":"The appearance to use for the Draw.io editor. Use \"automatic\" to automatically choose a Draw.io theme that matches your current VS Code theme."}}}],"menus":{"explorer/context":[{"when":"electropol-fr.drawio-diagrams-editor.active","command":"electropol-fr.drawio-diagrams-editor.linkFileWithSelectedNode","group":"Draw.io"}],"commandPalette":[{"when":"false","command":"electropol-fr.drawio-diagrams-editor.linkFileWithSelectedNode"},{"when":"isWindows","command":"electropol-fr.drawio-diagrams-editor.associateFileType"}],"editor/title":[{"command":"electropol-fr.drawio-diagrams-editor.openAsText","when":"activeCustomEditorId == 'electropol-fr.drawio-diagrams-editor-text' || activeCustomEditorId == 'electropol-fr.drawio-diagrams-editor'","group":"navigation"},{"command":"electropol-fr.drawio-diagrams-editor.openAsDiagram","when":"!activeCustomEditorId && resourceFilename =~ /\\.(drawio|dio)(\\.svg|\\.png)?$/","group":"navigation"}]}},"scripts":{"vscode:prepublish":"yarn build-extension && yarn build-plugins","run-script":"node ./scripts/run-script","lint":"echo 'add linting'","_lint":"yarn run-script check-version && prettier --check ./src","build":"yarn build-extension && yarn build-plugins && yarn package-extension","build-extension":"webpack --mode production","build-plugins":"webpack --mode production --config ./drawio-custom-plugins/webpack.config.ts","package-extension":"yarn package-extension-stable","package-extension-stable":"node ./scripts/package-vsix.mjs","package-extension-preRelease":"node ./scripts/package-vsix.mjs --pre-release","dev":"webpack --mode development --watch","dev-drawio-plugins":"webpack --mode development --watch --config ./drawio-custom-plugins/webpack.config.ts","dev-drawio-plugins-web":"webpack-dev-server --hot --config ./drawio-custom-plugins/webpack.config.ts"},"devDependencies":{"@actions/exec":"^1.0.4","@actions/github":"^2.2.0","@hediet/semver":"^0.2.1","@types/copy-webpack-plugin":"^8.0.1","@types/mithril":"^2.0.4","@types/node":"^22.10.10","@types/vscode":"1.73.0","@types/xml-formatter":"^1.1.0","@vscode/vsce":"^3.2.1","clean-webpack-plugin":"^4.0.0-alpha.0","copy-webpack-plugin":"^9.0.1","css-loader":"^3.4.2","ovsx":"^0.1.0-next.e000fdb","prettier":"^2.3.2","raw-loader":"^4.0.1","style-loader":"^1.1.3","ts-loader":"^9.2.3","ts-node":"^10.1.0","typescript":"^5.7.3","webpack":"^5.44.0","webpack-cli":"^4.7.2","webpack-dev-server":"^3.11.2"},"dependencies":{"@hediet/json-to-dictionary":"^0.2.1","@hediet/std":"0.6.0","@knuddels/mobx-logger":"^1.1.1","buffer":"^6.0.3","js-sha256":"^0.9.0","mithril":"^2.0.4","mobx":"5.15.4","mobx-utils":"5.5.7","path-browserify":"^1.0.1","vsls":"^1.0.3015","xml-f